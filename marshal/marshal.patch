diff --git a/lib/useFeed.ts b/lib/useFeed.ts
new file mode 100644
index 0000000..cd69dec
--- /dev/null
+++ b/lib/useFeed.ts
@@ -0,0 +1,96 @@
+"use client";
+import { useEffect, useRef, useState } from "react";
+import { upsertRow, type Row, type Snapshot, type StreamEvent, type WalletState } from "@/lib/stream-types";
+
+/** Live rows + wallet from /api/stream (SSE); falls back to polling /api/poll if nothing arrives in 4 s. */
+export function useFeed(onEvent?: (ev: StreamEvent) => void) {
+  const [rows, setRows] = useState<Row[]>([]);
+  const [wallet, setWallet] = useState<WalletState | null>(null);
+  const [connected, setConnected] = useState(false);
+  const [loaded, setLoaded] = useState(false);
+  const cb = useRef(onEvent);
+  useEffect(() => {
+    cb.current = onEvent;
+  }, [onEvent]);
+
+  useEffect(() => {
+    let stopped = false;
+    const apply = (ev: StreamEvent) => {
+      if (stopped || !ev || typeof ev !== "object") return;
+      if (ev.type === "snapshot") {
+        setRows(ev.data.rows ?? []);
+        if (ev.data.wallet) setWallet(ev.data.wallet);
+        setLoaded(true);
+      } else if (ev.type === "row") {
+        setRows((r) => upsertRow(r, ev.row));
+      } else if (ev.type === "wallet") {
+        setWallet(ev.wallet);
+      }
+      cb.current?.(ev);
+    };
+
+    let got = false;
+    let es: EventSource | null = null;
+    let pollTimer: ReturnType<typeof setTimeout> | null = null;
+
+    const startPoll = () => {
+      let since = 0;
+      const tick = async () => {
+        if (stopped) return;
+        try {
+          const r = await fetch(`/api/poll?since=${since}`, { cache: "no-store" });
+          if (!r.ok) throw new Error(String(r.status));
+          const j = (await r.json()) as { seq: number; snapshot?: Snapshot; events?: StreamEvent[] };
+          if (j.snapshot) apply({ type: "snapshot", data: j.snapshot });
+          for (const ev of j.events ?? []) apply(ev);
+          if (typeof j.seq === "number") since = j.seq;
+          if (!stopped) setConnected(true);
+        } catch {
+          if (!stopped) setConnected(false);
+        }
+        if (!stopped) pollTimer = setTimeout(tick, 1000);
+      };
+      void tick();
+    };
+
+    try {
+      es = new EventSource("/api/stream");
+      es.onopen = () => !stopped && setConnected(true);
+      es.onerror = () => !stopped && setConnected(false);
+      es.onmessage = (m) => {
+        got = true;
+        try {
+          apply(JSON.parse(m.data) as StreamEvent);
+          setConnected(true);
+        } catch {}
+      };
+    } catch {}
+
+    const fallback = setTimeout(() => {
+      if (got || stopped) return;
+      es?.close();
+      es = null;
+      startPoll();
+    }, 4000);
+
+    return () => {
+      stopped = true;
+      clearTimeout(fallback);
+      if (pollTimer) clearTimeout(pollTimer);
+      es?.close();
+    };
+  }, []);
+
+  return { rows, wallet, connected, loaded };
+}
+
+const inrFmt = new Intl.NumberFormat("en-IN");
+/** "₹10,000" from a whole-rupee string/number. */
+export const inr = (n: string | number | null | undefined) => {
+  const v = Number(n ?? 0);
+  return `₹${inrFmt.format(Number.isFinite(v) ? v : 0)}`;
+};
+/** 0x1234…abcd */
+export const short = (a: string | null | undefined) => (a ? `${a.slice(0, 6)}…${a.slice(-4)}` : "");
+export const timeOf = (ms: number) =>
+  new Date(ms).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false });
