+// Deploy Funder (creates tINR) + MarshalWallet on Monad testnet, seed the demo world, write deployments/testnet.json.
+// usage: SERVER_PK=0x... node scripts/deploy.mjs      (run `forge build` in contracts/ first)
+import { readFileSync, writeFileSync } from "node:fs";
+import { createPublicClient, createWalletClient, defineChain, encodeFunctionData, fallback, getAddress, http, keccak256, parseEther, stringToBytes } from "viem";
+import { privateKeyToAccount } from "viem/accounts";
+
+const RPCS = (process.env.MONAD_RPC_HTTP || "https://testnet-rpc.monad.xyz,https://rpc.ankr.com/monad_testnet,https://rpc-testnet.monadinfra.com").split(",").map((s) => s.trim()).filter(Boolean);
+const chain = defineChain({ id: 10143, name: "Monad Testnet", nativeCurrency: { name: "MON", symbol: "MON", decimals: 18 }, rpcUrls: { default: { http: RPCS } } });
+const transport = fallback(RPCS.map((u) => http(u, { timeout: 15_000, retryCount: 2 })));
+const pub = createPublicClient({ chain, transport });
+const pk = process.env.SERVER_PK?.trim();
+if (!pk) throw new Error("SERVER_PK missing");
+const account = privateKeyToAccount(pk.startsWith("0x") ? pk : `0x${pk}`);
+const wallet = createWalletClient({ chain, transport, account });
+const art = (name) => JSON.parse(readFileSync(new URL(`../contracts/out/${name}.sol/${name}.json`, import.meta.url), "utf8"));
+const INR = 10n ** 18n;
+const fees = { maxPriorityFeePerGas: 2_000_000_000n, maxFeePerGas: 202_000_000_000n };
+
+async function deploy(name, args, gas) {
+  const a = art(name);
+  const hash = await wallet.deployContract({ abi: a.abi, bytecode: a.bytecode.object, args, gas, ...fees });
+  const r = await pub.waitForTransactionReceipt({ hash, pollingInterval: 400, timeout: 60_000 });
+  if (r.status !== "success") throw new Error(`${name} deploy reverted ${hash}`);
+  console.log(name, r.contractAddress, hash);
+  return { address: getAddress(r.contractAddress), block: r.blockNumber, abi: a.abi };
+}
+async function send(to, abi, functionName, args, gas = 200_000n) {
+  const hash = await wallet.sendTransaction({ to, data: encodeFunctionData({ abi, functionName, args }), gas, ...fees });
+  const r = await pub.waitForTransactionReceipt({ hash, pollingInterval: 400, timeout: 60_000 });
+  if (r.status !== "success") throw new Error(`${functionName} reverted ${hash}`);
+  console.log(" ", functionName, hash);
+}
+
+console.log("deployer/agent", account.address, "MON", Number(await pub.getBalance({ address: account.address })) / 1e18);
+const funder = await deploy("Funder", [account.address], 3_000_000n);
+const token = getAddress(await pub.readContract({ address: funder.address, abi: funder.abi, functionName: "token" }));
+// owner = server for now (handover to the owner phone from /owner); agent = server (its session key)
+const marshal = await deploy("MarshalWallet", [token, account.address, account.address, 3_000n * INR, 8_000n * INR, 1_000n * INR], 2_500_000n);
+await send(funder.address, funder.abi, "fund", [[marshal.address], 0n, 10_000n * INR], 250_000n);
+const shops = [
+  { name: "Pune Books", what: "books and stationery" },
+  { name: "Kirana Mart", what: "groceries" },
+  { name: "Metro Card", what: "transit top-ups" },
+].map((s) => ({ ...s, address: getAddress(`0x${keccak256(stringToBytes(`marshal.shop.${s.name}`)).slice(26)}`) }));
+for (const s of shops) await send(marshal.address, marshal.abi, "setAllowlist", [s.address, true], 120_000n);
+const out = { chainId: 10143, marshal: marshal.address, token, funder: funder.address, deployBlock: Number(funder.block), merchants: shops };
+writeFileSync(new URL("../deployments/testnet.json", import.meta.url), JSON.stringify(out, null, 2) + "\n");
+console.log(JSON.stringify(out, null, 2));
