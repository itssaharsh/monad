+++ b/components/Stamp.tsx
@@ -0,0 +1,67 @@
+import { REASON_TEXT, type Row, type Verdict } from "@/lib/stream-types";
+
+export type Tone = "ok" | "no" | "wait" | "idle";
+
+export const toneOf = (v: Verdict): Tone =>
+  v === "allowed" || v === "approved" ? "ok" : v === "refused" || v === "denied" ? "no" : v === "waiting" ? "wait" : "idle";
+
+export const BAR: Record<Tone, string> = { ok: "var(--ok)", no: "var(--no)", wait: "var(--wait)", idle: "var(--idle)" };
+
+export function verdictWord(row: Pick<Row, "verdict" | "reason">): string {
+  switch (row.verdict) {
+    case "allowed":
+      return "ALLOWED";
+    case "refused":
+      return row.reason === "AgentRevoked" ? "AGENT REVOKED" : "REFUSED";
+    case "waiting":
+      return "WAITING";
+    case "approved":
+      return "APPROVED";
+    case "denied":
+      return "DENIED";
+    case "declined":
+      return "AGENT DIDN'T PAY";
+    case "sending":
+      return "CHECKING";
+    case "error":
+      return "NO RESULT";
+  }
+}
+
+/** The short reason shown next to a stamp. */
+export function reasonLine(row: Row): string {
+  switch (row.verdict) {
+    case "allowed":
+      return row.toName ? `Paid to ${row.toName}` : "Paid";
+    case "refused":
+      return REASON_TEXT[row.reason] || "The wallet said no";
+    case "waiting":
+      return "Owner decides";
+    case "approved":
+      return "Approved by owner";
+    case "denied":
+      return "Denied by owner";
+    case "declined":
+      return "Agent didn't pay";
+    case "sending":
+      return "Checking with the wallet…";
+    case "error":
+      return row.tx ? "Still checking…" : row.error ?? "Didn't reach the wallet";
+  }
+}
+
+const STYLE: Record<Tone, React.CSSProperties> = {
+  ok: { color: "var(--ok)" },
+  no: { color: "var(--no)" },
+  wait: { color: "var(--wait)", background: "var(--wait-fill)" },
+  idle: { color: "var(--ink-muted)" },
+};
+
+export function Stamp({ row, size = 28 }: { row: Pick<Row, "verdict" | "reason">; size?: number }) {
+  const tone = toneOf(row.verdict);
+  return (
+    <span key={row.verdict} className="stamp thunk" style={{ ...STYLE[tone], fontSize: size }}>
+      {verdictWord(row)}
+    </span>
+  );
+}
diff --git a/components/VerdictCard.tsx b/components/VerdictCard.tsx
