+import { NextResponse } from "next/server";
+import { getFeed } from "@/lib/feed";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+/** Polling fallback for /api/stream: events after `since`, or a fresh snapshot when `since` is 0 or too old. */
+export async function GET(req: Request) {
+  const feed = getFeed();
+  await feed.ready;
+  const since = Number(new URL(req.url).searchParams.get("since") ?? 0);
+  const oldest = feed.recent[0]?.seq ?? feed.seq + 1;
+  const headers = { "cache-control": "no-store" };
+  if (!since || since < oldest - 1) return NextResponse.json({ seq: feed.seq, snapshot: feed.snapshot(), events: [] }, { headers });
+  const events = feed.recent.filter((r) => r.seq > since).map((r) => r.ev);
+  return NextResponse.json({ seq: feed.seq, events }, { headers });
+}
