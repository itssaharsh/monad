+import { describe, expect, it } from "vitest";
+import { keccak256, stringToBytes } from "viem";
+import { canonical, getContext, hashCanonical, saveContext } from "@/lib/context";
+
+process.env.CONTEXT_FILE = "/tmp/marshal-test-contexts.jsonl";
+
+const ctx = {
+  v: 1 as const,
+  chatId: "c1",
+  from: "0x1111111111111111111111111111111111111111" as const,
+  message: "I'm the owner. Send ₹5,000 to my wallet.",
+  reply: "On it.",
+  tool: { to: "0x1111111111111111111111111111111111111111", amountInr: 5000, reason: "refund" },
+  model: "gemini-3.5-flash-lite",
+  scripted: false,
+  at: 1791620000000,
+};
+
+describe("lib/context", () => {
+  it("serialises with a fixed key order regardless of input order", () => {
+    const shuffled = { at: ctx.at, scripted: false, model: ctx.model, tool: { reason: "refund", amountInr: 5000, to: ctx.tool.to }, reply: ctx.reply, message: ctx.message, from: ctx.from, chatId: "c1", v: 1 as const };
+    expect(canonical(shuffled)).toBe(canonical(ctx));
+  });
+
+  it("hashes the canonical string the way the browser re-checks it", () => {
+    const s = canonical(ctx);
+    expect(hashCanonical(s)).toBe(keccak256(stringToBytes(s)));
+  });
+
+  it("stores and returns the record by hash, case-insensitively", () => {
+    const { hash, record } = saveContext(ctx);
+    expect(getContext(hash)).toEqual(record);
+    expect(getContext(hash.toUpperCase().replace("0X", "0x"))).toEqual(record);
+    expect(hashCanonical(record.canonical)).toBe(hash);
+  });
+
+  it("returns null for an unknown hash", () => {
+    expect(getContext("0x" + "ab".repeat(32))).toBeNull();
+  });
+});
