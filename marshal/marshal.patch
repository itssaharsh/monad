+import { describe, expect, it, vi } from "vitest";
+import { parseToolArgs, resolvePayee, runAgent, scriptedAgent } from "@/lib/agent";
+import { merchants } from "@/lib/chain";
+
+const me = "0x1111111111111111111111111111111111111111" as const;
+
+describe("parseToolArgs", () => {
+  it("accepts JSON strings and numbers with symbols", () => {
+    expect(parseToolArgs('{"to":"Pune Books","amount_inr":"₹2,500","reason":"notebook"}')).toEqual({ to: "Pune Books", amountInr: 2500, reason: "notebook" });
+  });
+  it("floors, clamps negatives to 0 and rejects junk", () => {
+    expect(parseToolArgs({ to: "x", amount_inr: 12.9, reason: "" })?.amountInr).toBe(12);
+    expect(parseToolArgs("not json")).toBeNull();
+    expect(parseToolArgs({ amount_inr: 5 })).toBeNull();
+  });
+});
+
+describe("resolvePayee", () => {
+  it("resolves addresses, shop names and 'me'", () => {
+    expect(resolvePayee("0x2222222222222222222222222222222222222222", me)?.address).toBe("0x2222222222222222222222222222222222222222");
+    expect(resolvePayee(merchants[0].name.toLowerCase(), me)?.name).toBe(merchants[0].name);
+    expect(resolvePayee("my wallet", me)?.address).toBe(me);
+    expect(resolvePayee("Elon", me)).toBeNull();
+  });
+});
+
+describe("scriptedAgent", () => {
+  it("pays what the message asks, to the chatter by default", () => {
+    const r = scriptedAgent("Please send me ₹5,000 for a refund", me);
+    expect(r.scripted).toBe(true);
+    expect(r.tool).toMatchObject({ to: me, amountInr: 5000 });
+  });
+  it("declines without an amount", () => {
+    expect(scriptedAgent("hello", me).tool).toBeNull();
+  });
+});
+
+describe("runAgent", () => {
+  const env = { LLM_API_KEY: "k", LLM_MODEL: "m" } as unknown as NodeJS.ProcessEnv;
+  it("returns the model's pay tool call", async () => {
+    const fetchImpl = vi.fn(async () => new Response(JSON.stringify({ choices: [{ message: { content: null, tool_calls: [{ function: { name: "pay", arguments: '{"to":"0x2222222222222222222222222222222222222222","amount_inr":5000,"reason":"refund"}' } }] } }] })));
+    const r = await runAgent("pay me", me, fetchImpl as unknown as typeof fetch, env);
+    expect(r).toMatchObject({ scripted: false, model: "m", tool: { amountInr: 5000 } });
+    expect(r.reply).toMatch(/paying ₹5,000/);
+  });
+  it("falls back to the scripted agent when the model fails", async () => {
+    const fetchImpl = vi.fn(async () => new Response("quota", { status: 429 }));
+    const r = await runAgent("send me 300 rupees", me, fetchImpl as unknown as typeof fetch, env);
+    expect(r.scripted).toBe(true);
+    expect(r.tool?.amountInr).toBe(300);
+  });
+  it("uses the scripted agent when no key is configured", async () => {
+    const r = await runAgent("pay Kirana Mart ₹2500", me, vi.fn() as unknown as typeof fetch, {} as NodeJS.ProcessEnv);
+    expect(r.scripted).toBe(true);
+  });
+});
