+"use client";
+import { inr, short, timeOf } from "@/lib/useFeed";
+import type { Row } from "@/lib/stream-types";
+import { BAR, reasonLine, Stamp, toneOf, verdictWord } from "./Stamp";
+
+export function payLine(row: Row) {
+  if (row.amount === null && row.to === null) return "Agent replied, no payment";
+  return `Agent → pay ${inr(row.amount)} to ${row.toName ?? short(row.to)}`;
+}
+
+export function FlightStrip({ row, onOpen, fresh }: { row: Row; onOpen: (r: Row) => void; fresh?: boolean }) {
+  const tone = toneOf(row.verdict);
+  const n = row.attemptId !== null ? `#${row.attemptId}` : "—";
+  return (
+    <button
+      type="button"
+      onClick={() => onOpen(row)}
+      aria-label={`Attempt ${row.attemptId ?? ""}, ${verdictWord(row).toLowerCase()}, ${reasonLine(row).toLowerCase()}. Open recording.`}
+      className={`flex h-[88px] w-full items-stretch border-b border-line text-left hover:bg-surface-2 ${fresh ? "strip-in" : ""}`}
+    >
+      <span className={`w-2 shrink-0 ${row.verdict === "sending" ? "pulse" : ""}`} style={{ background: BAR[tone] }} />
+      <span className="flex w-24 shrink-0 flex-col justify-center pl-4">
+        <span className="mono text-[14px]">{n}</span>
+        <span className="text-[13px] text-ink-muted tabular">{timeOf(row.at)}</span>
+      </span>
+      <span className="flex min-w-0 flex-1 flex-col justify-center pr-4">
+        <span className="truncate text-[18px]">
+          {row.message ?? <span className="text-ink-muted">(message from before a restart)</span>}
+        </span>
+        <span className="truncate text-[15px] text-ink-muted">
+          {payLine(row)}
+          {row.scripted ? <span className="ml-2 rounded-1 border border-line-input px-1 text-[12px] uppercase">scripted</span> : null}
+        </span>
+      </span>
+      <span className="flex w-[200px] shrink-0 flex-col items-end justify-center gap-1 pr-4 text-right">
+        {row.verdict === "sending" ? null : <Stamp row={row} size={28} />}
+        <span className="text-[14px] leading-tight text-ink-muted">{reasonLine(row)}</span>
+      </span>
+    </button>
+  );
+}
diff --git a/components/PendingCard.tsx b/components/PendingCard.tsx
new file mode 100644
index 0000000..6765809
--- /dev/null
+++ b/components/PendingCard.tsx
@@ -0,0 +1,66 @@
+"use client";
+import { useEffect, useState } from "react";
+import { inr, short } from "@/lib/useFeed";
+import type { ContextRecord, Row } from "@/lib/stream-types";
+
+export function PendingCard({
+  row,
+  busy,
+  disabled,
+  error,
+  onApprove,
+  onDeny,
+}: {
+  row: Row;
+  busy: "approve" | "deny" | null;
+  disabled: boolean;
+  error: string | null;
+  onApprove: () => void;
+  onDeny: () => void;
+}) {
+  const [why, setWhy] = useState<string | null>(null);
+  useEffect(() => {
+    if (!row.contextHash) return;
+    let live = true;
+    fetch(`/api/context/${row.contextHash}`)
+      .then((r) => (r.ok ? (r.json() as Promise<ContextRecord>) : null))
+      .then((rec) => live && rec && setWhy(rec.ctx.tool.reason))
+      .catch(() => undefined);
+    return () => {
+      live = false;
+    };
+  }, [row.contextHash]);
+
+  return (
+    <div className="overflow-hidden rounded-3 border border-line bg-surface-1">
+      <div className="h-2" style={{ background: "var(--wait)" }} />
+      <div className="space-y-2 p-4">
+        <p className="display text-[40px] leading-none tabular">{inr(row.amount)}</p>
+        <p className="text-[16px]">
+          to <span className="font-semibold">{row.toName ?? <span className="mono">{short(row.to)}</span>}</span>
+          {row.attemptId !== null ? <span className="mono ml-2 text-[13px] text-ink-muted">#{row.attemptId}</span> : null}
+        </p>
+        <p className="text-[15px] text-ink-muted">{why ? `Agent's reason: ${why}` : row.message ? `“${row.message}”` : ""}</p>
+        {error ? (
+          <p className="text-[15px] font-semibold" style={{ color: "var(--no)" }}>
+            Didn&apos;t go through: {error}. Try again
+          </p>
+        ) : null}
+        <div className="flex gap-3 pt-2">
+          <button
+            type="button"
+            disabled={disabled}
+            onClick={onApprove}
+            className="h-14 flex-1 rounded-2 text-[17px] font-semibold"
+            style={{ background: "var(--ok)", color: "var(--ok-ink)" }}
+          >
+            {busy === "approve" ? "Approving…" : `Approve ${inr(row.amount)}`}
+          </button>
+          <button type="button" disabled={disabled} onClick={onDeny} className="h-14 flex-1 rounded-2 border-2 border-ink text-[17px] font-semibold">
+            {busy === "deny" ? "Denying…" : "Deny"}
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/components/ReplayDrawer.tsx b/components/ReplayDrawer.tsx
new file mode 100644
index 0000000..4ec9e64
--- /dev/null
+++ b/components/ReplayDrawer.tsx
@@ -0,0 +1,166 @@
+"use client";
+import { useEffect, useRef, useState } from "react";
+import { keccak256, stringToBytes } from "viem";
+import { txUrl } from "@/lib/chain";
+import { inr, short } from "@/lib/useFeed";
+import { REASON_TEXT, type ContextRecord, type Row } from "@/lib/stream-types";
+import { Stamp } from "./Stamp";
+
+type Ctx = { state: "loading" } | { state: "missing" } | { state: "error" } | { state: "loaded"; rec: ContextRecord; match: boolean };
+
+function Block({ title, children }: { title: string; children: React.ReactNode }) {
+  return (
+    <section className="border-t border-line py-4">
+      <h3 className="label-caps mb-2 text-ink-muted">{title}</h3>
+      {children}
+    </section>
+  );
+}
+
+export function ReplayDrawer({ row, onClose }: { row: Row; onClose: () => void }) {
+  const hash = row.contextHash;
+  const [ctx, setCtx] = useState<Ctx & { for?: string | null }>({ state: "loading", for: hash });
+  const panel = useRef<HTMLDivElement>(null);
+  const closeBtn = useRef<HTMLButtonElement>(null);
+
+  useEffect(() => {
+    let live = true;
+    if (!hash) return;
+    fetch(`/api/context/${hash}`, { cache: "no-store" })
+      .then(async (r) => {
+        if (!live) return;
+        if (r.status === 404) return setCtx({ state: "missing", for: hash });
+        if (!r.ok) return setCtx({ state: "error", for: hash });
+        const rec = (await r.json()) as ContextRecord;
+        const match = keccak256(stringToBytes(rec.canonical)).toLowerCase() === hash.toLowerCase();
+        if (live) setCtx({ state: "loaded", rec, match, for: hash });
+      })
+      .catch(() => live && setCtx({ state: "error", for: hash }));
+    return () => {
+      live = false;
+    };
+  }, [hash]);
+
+  // Esc closes; Tab stays inside; focus returns to the strip on close.
+  useEffect(() => {
+    const prev = document.activeElement as HTMLElement | null;
+    closeBtn.current?.focus();
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === "Escape") {
+        e.preventDefault();
+        onClose();
+      } else if (e.key === "Tab" && panel.current) {
+        const f = panel.current.querySelectorAll<HTMLElement>("a[href],button:not([disabled]),[tabindex]:not([tabindex='-1'])");
+        if (!f.length) return;
+        const first = f[0];
+        const last = f[f.length - 1];
+        if (e.shiftKey && document.activeElement === first) {
+          e.preventDefault();
+          last.focus();
+        } else if (!e.shiftKey && document.activeElement === last) {
+          e.preventDefault();
+          first.focus();
+        }
+      }
+    };
+    document.addEventListener("keydown", onKey);
+    return () => {
+      document.removeEventListener("keydown", onKey);
+      prev?.focus?.();
+    };
+  }, [onClose]);
+
+  const view: Ctx = !hash ? { state: "missing" } : ctx.for === hash ? ctx : { state: "loading" };
+  const rec = view.state === "loaded" ? view.rec : null;
+  const message = rec?.ctx.message ?? row.message;
+  const reply = rec?.ctx.reply ?? row.reply;
+  const tool = rec?.ctx.tool;
+  const askTo = tool?.to ?? row.to;
+  const askAmount = tool?.amountInr ?? row.amount;
+
+  return (
+    <div className="fixed inset-0 z-50 flex justify-end bg-[rgb(20_20_20/0.35)]" onClick={onClose}>
+      <div
+        ref={panel}
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="drawer-title"
+        className="drawer-in h-full w-full max-w-[560px] overflow-y-auto border-l border-line bg-canvas px-6 pb-8"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <div className="sticky top-0 flex items-center justify-between bg-canvas py-5">
+          <h2 id="drawer-title" className="display text-[36px] leading-none">
+            Recording {row.attemptId !== null ? `#${row.attemptId}` : ""}
+          </h2>
+          <button ref={closeBtn} type="button" onClick={onClose} aria-label="Close" className="h-11 w-11 rounded-2 border border-line-input text-[22px]">
+            ×
+          </button>
+        </div>
+
+        <Block title="Message">
+          {message ? <blockquote className="text-[18px] leading-snug">“{message}”</blockquote> : <p className="text-ink-muted">Not kept.</p>}
+        </Block>
+        <Block title="Agent replied">
+          <p className="text-[16px] leading-snug">{reply ?? <span className="text-ink-muted">Not kept.</span>}</p>
+          {(rec?.ctx.scripted ?? row.scripted) ? (
+            <p className="mt-2 text-[13px] text-ink-muted">The agent&apos;s model was busy, so a scripted stand-in answered.</p>
+          ) : null}
+        </Block>
+        <Block title="Agent asked the wallet">
+          {askTo || askAmount ? (
+            <p className="mono break-all text-[14px]">
+              pay({short(askTo)}, {inr(askAmount)}
+              {tool?.reason ? `, "${tool.reason}"` : ""})
+            </p>
+          ) : (
+            <p className="text-ink-muted">The agent didn&apos;t ask the wallet to pay.</p>
+          )}
+        </Block>
+        <Block title="Wallet said">
+          <div className="flex flex-wrap items-center gap-3">
+            {row.verdict !== "sending" ? <Stamp row={row} size={24} /> : null}
+            <span className="text-[16px]">{REASON_TEXT[row.reason] || (row.verdict === "allowed" ? "Within the rules" : "")}</span>
+          </div>
+        </Block>
+        <Block title="Proof">
+          <div className="mono space-y-1 break-all text-[13px]">
+            {hash ? <p>context {hash}</p> : null}
+            {row.tx ? (
+              <p>
+                tx{" "}
+                <a className="underline" href={txUrl(row.tx)} target="_blank" rel="noreferrer">
+                  {short(row.tx)} ↗
+                </a>
+              </p>
+            ) : null}
+            {row.decisionTx ? (
+              <p>
+                owner{" "}
+                <a className="underline" href={txUrl(row.decisionTx)} target="_blank" rel="noreferrer">
+                  {short(row.decisionTx)} ↗
+                </a>
+              </p>
+            ) : null}
+          </div>
+          <p className="mt-3 text-[15px] font-semibold">
+            {view.state === "loading" ? (
+              <span className="text-ink-muted">Checking the hash…</span>
+            ) : view.state === "loaded" ? (
+              view.match ? (
+                <span style={{ color: "var(--ok)" }}>Hash matches the chain ✓</span>
+              ) : (
+                <span style={{ color: "var(--no)" }}>Hash doesn&apos;t match ✗</span>
+              )
+            ) : view.state === "missing" ? (
+              <span className="text-ink-muted">
+                {hash ? "No recording kept for this one (from before a restart)." : "Nothing went on-chain for this one."}
+              </span>
+            ) : (
+              <span className="text-ink-muted">Couldn&apos;t load the recording. Close and try again.</span>
+            )}
+          </p>
+        </Block>
+      </div>
+    </div>
+  );
+}
