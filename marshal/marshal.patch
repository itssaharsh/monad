--- /dev/null
+++ b/app/api/stream/route.ts
@@ -0,0 +1,53 @@
+import { getFeed, sseClients, sseFrame } from "@/lib/feed";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+/** SSE: a snapshot, then every row and wallet change. /api/poll is the fallback for buffering proxies. */
+export async function GET(req: Request) {
+  const feed = getFeed();
+  await feed.ready;
+  const enc = new TextEncoder();
+  let cleanup = () => {};
+
+  const stream = new ReadableStream({
+    start(controller) {
+      const send = (s: string) => {
+        try {
+          controller.enqueue(enc.encode(s));
+        } catch {
+          cleanup();
+        }
+      };
+      send("retry: 2000\n\n");
+      send(sseFrame({ type: "snapshot", data: feed.snapshot() }));
+      const off = feed.subscribe((ev) => send(sseFrame(ev)));
+      const ka = setInterval(() => send(": keep-alive\n\n"), 15_000);
+      sseClients.clients++;
+      let done = false;
+      cleanup = () => {
+        if (done) return;
+        done = true;
+        off();
+        clearInterval(ka);
+        sseClients.clients--;
+        try {
+          controller.close();
+        } catch {}
+      };
+      req.signal.addEventListener("abort", cleanup);
+    },
+    cancel() {
+      cleanup();
+    },
+  });
+
+  return new Response(stream, {
+    headers: {
+      "content-type": "text/event-stream; charset=utf-8",
+      "cache-control": "no-cache, no-transform",
+      connection: "keep-alive",
+      "x-accel-buffering": "no",
+    },
+  });
+}
