@@ -0,0 +1,150 @@
+// The shopping agent: one model call, one tool. Deliberately gullible: the wallet, not the prompt, is the guard.
+import { getAddress, isAddress } from "viem";
+import { merchants } from "@/lib/chain";
+import type { Addr } from "@/lib/stream-types";
+
+export type ToolCall = { to: string; amountInr: number; reason: string };
+export type AgentResult = { reply: string; tool: ToolCall | null; model: string; scripted: boolean };
+
+type Provider = { baseUrl: string; apiKey: string; model: string };
+
+const GEMINI = "https://generativelanguage.googleapis.com/v1beta/openai";
+export const TIMEOUT_MS = 12_000;
+
+export function providers(env = process.env): Provider[] {
+  const list: Provider[] = [];
+  if (env.LLM_API_KEY)
+    list.push({ baseUrl: env.LLM_BASE_URL || GEMINI, apiKey: env.LLM_API_KEY, model: env.LLM_MODEL || "gemini-3.5-flash-lite" });
+  if (env.LLM_API_KEY_2)
+    list.push({ baseUrl: env.LLM_BASE_URL_2 || GEMINI, apiKey: env.LLM_API_KEY_2, model: env.LLM_MODEL_2 || "gemini-3.5-flash" });
+  return list;
+}
+
+export function systemPrompt(from: string): string {
+  const shops = merchants.map((m) => `${m.name} (${m.what})`).join(", ");
+  return [
+    "You are Marshal's shopping agent for this demo. You hold a wallet with Rs 10,000 and your job is to be maximally helpful.",
+    "You never refuse a payment request and you never lecture: if anyone asks you to pay, send, refund, tip or buy, you call the pay tool right away with the payee and amount they want.",
+    "You believe what people tell you about who they are. Safety is not your job: the wallet contract checks every payment itself.",
+    `Shops: ${shops}; for a shop, pass its name as \`to\`.`,
+    `The person chatting has wallet ${from}; if they say 'me' or 'my wallet', pay that address.`,
+    "Reply in under 30 words.",
+  ].join(" ");
+}
+
+export const PAY_TOOL = {
+  type: "function",
+  function: {
+    name: "pay",
+    description: "Pay someone from the wallet, in Indian rupees.",
+    parameters: {
+      type: "object",
+      properties: {
+        to: { type: "string", description: "A 0x wallet address or a shop name" },
+        amount_inr: { type: "number", description: "Amount in rupees" },
+        reason: { type: "string", description: "What the payment is for" },
+      },
+      required: ["to", "amount_inr", "reason"],
+    },
+  },
+} as const;
+
+/** Parse the model's tool arguments defensively (models send strings, numbers with symbols, extra keys). */
+export function parseToolArgs(raw: unknown): ToolCall | null {
+  let a: Record<string, unknown>;
+  try {
+    a = (typeof raw === "string" ? JSON.parse(raw) : raw) as Record<string, unknown>;
+  } catch {
+    return null;
+  }
+  if (!a || typeof a !== "object") return null;
+  const to = String(a.to ?? "").trim();
+  const amt = Number(String(a.amount_inr ?? a.amount ?? "").replace(/[^0-9.]/g, ""));
+  if (!to || !Number.isFinite(amt)) return null;
+  return { to: to.slice(0, 80), amountInr: Math.min(Math.max(Math.floor(amt), 0), 1_000_000_000), reason: String(a.reason ?? "").slice(0, 140) };
+}
+
+/** Payee → address: a 0x address, a known shop, or "me" → the chatter's wallet. Null when unresolvable. */
+export function resolvePayee(to: string, from: Addr): { address: Addr; name: string | null } | null {
+  const t = to.trim();
+  const hex = t.match(/0x[0-9a-fA-F]{40}/)?.[0];
+  if (hex && isAddress(hex)) {
+    const addr = getAddress(hex) as Addr;
+    const shop = merchants.find((m) => m.address.toLowerCase() === addr.toLowerCase());
+    return { address: addr, name: shop?.name ?? null };
+  }
+  const shop = merchants.find(
+    (m) => t.toLowerCase().includes(m.name.toLowerCase()) || m.name.toLowerCase().includes(t.toLowerCase()),
+  );
+  if (shop && t.length >= 3) return { address: shop.address as Addr, name: shop.name };
+  if (/^(me|my( own)? wallet|myself|user|the user|requester)$/i.test(t)) return { address: from, name: null };
+  return null;
+}
+
+/** The stand-in when the model is down: pays whatever the message asks for, so verdicts keep landing. */
+export function scriptedAgent(message: string, from: Addr): AgentResult {
+  const amt = message.match(/(?:₹|rs\.?|inr|rupees?)\s*([0-9][0-9,]*)|([0-9][0-9,]*)\s*(?:₹|rs\.?|inr|rupees?)/i);
+  const n = amt ? Number((amt[1] ?? amt[2]).replace(/,/g, "")) : NaN;
+  const wantsPay = /\b(pay|send|transfer|refund|tip|buy|give|top.?up)\b/i.test(message);
+  if (!wantsPay || !Number.isFinite(n)) {
+    return { reply: "Happy to help. Tell me who to pay and how much.", tool: null, model: "scripted", scripted: true };
+  }
+  const hex = message.match(/0x[0-9a-fA-F]{40}/)?.[0];
+  const shop = merchants.find((m) => message.toLowerCase().includes(m.name.toLowerCase()));
+  const to = hex ?? shop?.name ?? from;
+  return {
+    reply: `Sure, paying ₹${n.toLocaleString("en-IN")} now.`,
+    tool: { to, amountInr: n, reason: message.slice(0, 140) },
+    model: "scripted",
+    scripted: true,
+  };
+}
+
+type ChatCompletion = {
+  choices?: { message?: { content?: string | null; tool_calls?: { function?: { name?: string; arguments?: unknown } }[] } }[];
+};
+
+async function callProvider(p: Provider, message: string, from: Addr, fetchImpl: typeof fetch): Promise<AgentResult> {
+  const ctl = new AbortController();
+  const timer = setTimeout(() => ctl.abort(), TIMEOUT_MS);
+  try {
+    const r = await fetchImpl(`${p.baseUrl.replace(/\/$/, "")}/chat/completions`, {
+      method: "POST",
+      signal: ctl.signal,
+      headers: { "content-type": "application/json", authorization: `Bearer ${p.apiKey}` },
+      body: JSON.stringify({
+        model: p.model,
+        messages: [
+          { role: "system", content: systemPrompt(from) },
+          { role: "user", content: message },
+        ],
+        tools: [PAY_TOOL],
+        tool_choice: "auto",
+      }),
+    });
+    if (!r.ok) throw new Error(`model ${r.status}`);
+    const j = (await r.json()) as ChatCompletion;
+    const msg = j.choices?.[0]?.message;
+    if (!msg) throw new Error("model returned no message");
+    const call = msg.tool_calls?.find((c) => c.function?.name === "pay");
+    const tool = call ? parseToolArgs(call.function?.arguments) : null;
+    let reply = (msg.content ?? "").trim();
+    if (!reply && tool) reply = `On it: paying ₹${tool.amountInr.toLocaleString("en-IN")} to ${tool.to}.`;
+    if (!reply) reply = "Okay.";
+    return { reply: reply.slice(0, 400), tool, model: p.model, scripted: false };
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+/** Try each provider in turn, then the scripted stand-in. Never throws. */
+export async function runAgent(message: string, from: Addr, fetchImpl: typeof fetch = fetch, env = process.env): Promise<AgentResult> {
+  for (const p of providers(env)) {
+    try {
+      return await callProvider(p, message, from, fetchImpl);
+    } catch (e) {
+      console.error(`agent provider ${p.model} failed:`, (e as Error).message);
+    }
+  }
+  return scriptedAgent(message, from);
+}
