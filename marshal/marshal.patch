+
+/** GET /api/context/<contextHash> → the exact string that was hashed on-chain, and it parsed. */
+export async function GET(_req: Request, ctx: { params: Promise<{ hash: string }> }) {
+  const { hash } = await ctx.params;
+  if (!/^0x[0-9a-fA-F]{64}$/.test(hash)) return NextResponse.json({ error: "bad hash" }, { status: 400 });
