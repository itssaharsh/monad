+    expect(c.left("0xAB", 0)).toBe(0);
+    c.take("0xAB", 0);
+    expect(c.left("0xab", 6_000)).toBe(9);
+    expect(c.left("0xab", 15_000)).toBe(0);
+  });
+});
+
+describe("RateLimiter", () => {
+  it("allows n per window", () => {
+    const r = new RateLimiter(2, 1000);
+    expect(r.allow("ip", 0)).toBe(true);
+    expect(r.allow("ip", 1)).toBe(true);
+    expect(r.allow("ip", 2)).toBe(false);
+    expect(r.allow("ip", 1001)).toBe(true);
+  });
+});
+
+describe("Gate", () => {
+  it("refuses beyond max + queue", async () => {
+    const g = new Gate(1, 1);
+    let release!: () => void;
+    const hold = new Promise<void>((r) => (release = r));
+    const a = g.run(() => hold.then(() => "a"));
+    const b = g.run(async () => "b");
+    expect(await g.run(async () => "c")).toBe("busy");
+    release();
+    expect(await a).toBe("a");
+    expect(await b).toBe("b");
+  });
+});
+
+describe("presenterOk", () => {
+  it("needs a configured key and an exact match", () => {
+    expect(presenterOk("x", undefined)).toBe(false);
