new file mode 100644
index 0000000..68c71b7
--- /dev/null
+++ b/lib/ownerTx.ts
@@ -0,0 +1,70 @@
+"use client";
+import { encodeFunctionData, type Abi, type Hex, type LocalAccount } from "viem";
+import abi from "@/lib/abi/MarshalWallet.json";
+import { addresses, GAS, maxFeeFor, TIP } from "@/lib/chain";
+
+export type OwnerFn = "approve" | "deny" | "revokeAgent" | "restoreAgent";
+export type OwnerTxResult = { ok: true; hash: Hex } | { ok: false; error: string };
+
+/** Turn a relay / revert message into a short sentence for "Didn't go through: <reason>". */
+export function humanize(msg: string | undefined | null): string {
+  const m = (msg ?? "").toLowerCase();
+  if (!m) return "unknown error";
+  if (m.includes("notowner")) return "this phone isn't the owner yet";
+  if (m.includes("notpending")) return "it was already decided";
+  if (m.includes("insufficientbalance")) return "not enough in the wallet";
+  if (m.includes("overdailycap")) return "over today's limit";
+  if (m.includes("insufficient funds") || m.includes("gas")) return "the owner wallet is out of gas";
+  if (m.includes("nonce")) return "the phone's tx count was stale, it's fixed now";
+  if (m.includes("fetch") || m.includes("network") || m.includes("reach")) return "couldn't reach Monad";
+  if (m.includes("timed out") || m.includes("timeout")) return "Monad didn't confirm in time";
+  return msg!.length > 80 ? `${msg!.slice(0, 80)}…` : msg!;
+}
+
+/** Sign an owner call on this phone, relay it via /api/send, then wait for the receipt (≤ 25 s). */
+export async function sendOwnerTx(account: LocalAccount, nonce: number, fn: OwnerFn, args: readonly unknown[] = []): Promise<OwnerTxResult> {
+  try {
+    const data = encodeFunctionData({ abi: abi as Abi, functionName: fn, args });
+    const raw = await account.signTransaction!({
+      chainId: 10143,
+      type: "eip1559",
+      to: addresses.marshal,
+      data,
+      gas: GAS.owner,
+      nonce,
+      maxPriorityFeePerGas: TIP,
+      maxFeePerGas: maxFeeFor(),
+    });
+    let hash: Hex | null = null;
+    let lastErr = "couldn't reach Monad";
+    for (let attempt = 0; attempt < 3 && !hash; attempt++) {
+      try {
+        const r = await fetch("/api/send", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ raw }) });
+        const j = await r.json().catch(() => ({}));
+        if (r.ok && j.hash) hash = j.hash as Hex;
+        else {
+          lastErr = j.error ?? `relay ${r.status}`;
+          if (r.status < 500 && r.status !== 429) break;
+        }
+      } catch {
+        lastErr = "couldn't reach Monad";
+      }
+      if (!hash) await new Promise((res) => setTimeout(res, 600 * (attempt + 1)));
+    }
+    if (!hash) return { ok: false, error: humanize(lastErr) };
+
+    const until = Date.now() + 25_000;
+    while (Date.now() < until) {
+      await new Promise((res) => setTimeout(res, 1000));
+      try {
+        const r = await fetch(`/api/send?hash=${hash}`, { cache: "no-store" });
+        const j = (await r.json()) as { status?: string; reason?: string };
+        if (j.status === "success") return { ok: true, hash };
+        if (j.status === "reverted") return { ok: false, error: humanize(j.reason ?? "reverted") };
+      } catch {}
+    }
+    return { ok: false, error: "Monad didn't confirm in time" };
+  } catch (e) {
+    return { ok: false, error: humanize((e as Error).message) };
+  }
+}
