+++ b/app/api/admin/handover/route.ts
@@ -0,0 +1,39 @@
+import { NextResponse } from "next/server";
+import { encodeFunctionData, getAddress, isAddress } from "viem";
+import { addresses, GAS, publicClient } from "@/lib/chain";
+import { getFeed, marshalAbi } from "@/lib/feed";
+import { presenterOk } from "@/lib/presenter";
+import { errText, getServerWallet } from "@/lib/server-wallet";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+/** POST {address, key} → the server (deployer, initial owner) hands wallet ownership to the owner phone. */
+export async function POST(req: Request) {
+  let body: { address?: unknown; key?: unknown };
+  try {
+    body = await req.json();
+  } catch {
+    return NextResponse.json({ ok: false, error: "json body required" }, { status: 400 });
+  }
+  if (!presenterOk(body.key)) return NextResponse.json({ ok: false, error: "This page needs the owner link." }, { status: 401 });
+  if (typeof body.address !== "string" || !isAddress(body.address)) return NextResponse.json({ ok: false, error: "bad address" }, { status: 400 });
+  const server = getServerWallet();
+  if (!server) return NextResponse.json({ ok: false, error: "server key missing" }, { status: 500 });
+  const c = publicClient();
+  try {
+    const owner = (await c.readContract({ address: addresses.marshal, abi: marshalAbi, functionName: "owner" })) as string;
+    if (owner.toLowerCase() !== server.address.toLowerCase())
+      return NextResponse.json({ ok: false, error: "the server no longer owns the wallet; ownership already moved" }, { status: 409 });
+    const hash = await server.sendTx({
+      to: addresses.marshal,
+      data: encodeFunctionData({ abi: marshalAbi, functionName: "transferOwnership", args: [getAddress(body.address)] }),
+      gas: GAS.owner,
+    });
+    await c.waitForTransactionReceipt({ hash, pollingInterval: 300, timeout: 20_000 });
+    await getFeed().refreshWallet();
+    return NextResponse.json({ ok: true, hash });
+  } catch (e) {
+    return NextResponse.json({ ok: false, error: errText(e).slice(0, 160) }, { status: 502 });
+  }
+}
