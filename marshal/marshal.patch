@@ -0,0 +1,48 @@
+import { NextResponse } from "next/server";
+import { recoverTransactionAddress, type Hex } from "viem";
+import { addresses, publicClient } from "@/lib/chain";
+import { getFeed } from "@/lib/feed";
+import { checkRawTx, MAX_BODY, RateLimiter } from "@/lib/guards";
+import { errText, getServerWallet, Relay } from "@/lib/server-wallet";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+const g = globalThis as unknown as { __sendLimiter?: RateLimiter; __sendRelay?: Relay };
+
+/** POST {raw} → forwards the owner phone's signed tx to MarshalWallet (never re-signs). */
+export async function POST(req: Request) {
+  const text = await req.text();
+  if (text.length > MAX_BODY) return NextResponse.json({ error: "body too large" }, { status: 413 });
+  let raw: unknown;
+  try {
+    raw = (JSON.parse(text) as { raw?: unknown }).raw;
+  } catch {
+    return NextResponse.json({ error: "json body {raw} required" }, { status: 400 });
+  }
+  const check = checkRawTx(raw, [addresses.marshal]);
+  if (!check.ok) return NextResponse.json({ error: check.error }, { status: check.status });
+  const from = await recoverTransactionAddress({ serializedTransaction: raw as Hex & `0x02${string}` });
+  g.__sendLimiter ??= new RateLimiter();
+  if (!g.__sendLimiter.allow(from)) return NextResponse.json({ error: "slow down: 5 transactions per 10 s" }, { status: 429 });
+  const relay = (g.__sendRelay ??= getServerWallet()?.relay ?? new Relay());
+  try {
+    const hash = await relay.send(raw as Hex);
+    void getFeed().watchOwnerTx(hash);
+    return NextResponse.json({ hash });
+  } catch (e) {
+    return NextResponse.json({ error: errText(e).slice(0, 200) }, { status: 502 });
+  }
+}
+
+/** GET ?hash= → how a relayed tx ended. */
+export async function GET(req: Request) {
+  const hash = new URL(req.url).searchParams.get("hash");
+  if (!hash || !/^0x[0-9a-fA-F]{64}$/.test(hash)) return NextResponse.json({ error: "hash required" }, { status: 400 });
+  try {
+    const r = await publicClient().getTransactionReceipt({ hash: hash as Hex });
+    return NextResponse.json(r.status === "success" ? { status: "success" } : { status: "reverted", reason: "the wallet refused this owner action" });
+  } catch {
+    return NextResponse.json({ status: "pending" });
+  }
+}
