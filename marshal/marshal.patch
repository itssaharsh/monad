@@ -0,0 +1,9 @@
+import { timingSafeEqual } from "node:crypto";
+
+/** The owner link carries PRESENTER_KEY; constant-time compare, and no key configured means locked. */
+export function presenterOk(given: unknown, key = process.env.PRESENTER_KEY): boolean {
+  if (!key || typeof given !== "string" || !given) return false;
+  const a = Buffer.from(given);
+  const b = Buffer.from(key);
+  return a.length === b.length && timingSafeEqual(a, b);
+}
diff --git a/lib/server-wallet.ts b/lib/server-wallet.ts
new file mode 100644
index 0000000..ee77f96
--- /dev/null
+++ b/lib/server-wallet.ts
@@ -0,0 +1,104 @@
+// The server's one key: deployer, the agent's session key (it can only call MarshalWallet.pay) and gas funder.
+// One key, one local nonce, serial signing (reused from Dibs' Operator).
+import { createPublicClient, http, keccak256, parseEther, type Hex, type PublicClient } from "viem";
+import { privateKeyToAccount, type PrivateKeyAccount } from "viem/accounts";
+import { maxFeeFor, monadTestnet, publicClient, rpcHttpUrls, TIP } from "@/lib/chain";
+
+export const RESERVE_FLOOR = parseEther("12"); // Monad keeps 10 MON reserve per EOA; never send value below this
+export const OWNER_GAS = parseEther("0.5"); // gas for the owner phone: ~20 owner txs
+
+export const errText = (e: unknown): string => {
+  const x = e as { shortMessage?: string; details?: string; message?: string };
+  return [x?.shortMessage, x?.details, x?.message].filter(Boolean).join(" · ") || String(e);
+};
+
+/** Raw-tx sender with rotation across RPCs and retry of the same signed bytes. */
+export class Relay {
+  clients: PublicClient[];
+  errors = 0;
+  private i = 0;
+  constructor(urls = rpcHttpUrls()) {
+    this.clients = urls.map((url) =>
+      createPublicClient({ chain: monadTestnet, transport: http(url, { timeout: 8_000, retryCount: 0 }) }),
+    );
+  }
+  async send(raw: Hex): Promise<Hex> {
+    let last: unknown;
+    for (let t = 0; t < Math.min(6, this.clients.length * 2); t++) {
+      const c = this.clients[this.i++ % this.clients.length];
+      try {
+        return await c.sendRawTransaction({ serializedTransaction: raw });
+      } catch (e) {
+        const msg = errText(e);
+        if (/already known|known transaction|already imported/i.test(msg)) return keccak256(raw);
+        // a definitive rejection from the node: don't spray it at other RPCs
+        if (/nonce too low|insufficient funds|invalid|exceeds|underpriced|reserve/i.test(msg)) throw e;
+        this.errors++;
+        last = e;
+      }
+    }
+    throw last;
+  }
+}
+
+export class ServerWallet {
+  account: PrivateKeyAccount;
+  relay = new Relay();
+  sent = 0;
+  private nonce: number | null = null;
+  private queue: Promise<unknown> = Promise.resolve();
+
+  constructor(pk: string) {
+    this.account = privateKeyToAccount((pk.startsWith("0x") ? pk : `0x${pk}`) as Hex);
+  }
+
+  get address() {
+    return this.account.address;
+  }
+
+  balance() {
+    return publicClient().getBalance({ address: this.address });
+  }
+
+  /** Serialise: sign with the next nonce and send. Resolves with the hash once a node accepted it. */
+  sendTx(tx: { to: Hex; data?: Hex; gas: bigint; value?: bigint }): Promise<Hex> {
+    const run = async (): Promise<Hex> => {
+      if (this.nonce === null) {
+        this.nonce = await publicClient().getTransactionCount({ address: this.address, blockTag: "pending" });
+      }
+      const raw = await this.account.signTransaction({
+        chainId: monadTestnet.id,
+        type: "eip1559",
+        to: tx.to,
+        data: tx.data ?? "0x",
+        value: tx.value ?? 0n,
+        gas: tx.gas,
+        nonce: this.nonce,
+        maxPriorityFeePerGas: TIP,
+        maxFeePerGas: maxFeeFor(),
+      });
+      try {
+        const hash = await this.relay.send(raw);
+        this.nonce++;
+        this.sent++;
+        return hash;
+      } catch (e) {
+        this.nonce = null; // resync from the chain on the next send
+        throw e;
+      }
+    };
+    const p = this.queue.then(run, run);
+    this.queue = p.catch(() => undefined);
+    return p;
+  }
+}
+
+const g = globalThis as unknown as { __marshalServer?: ServerWallet | null };
+
+export function getServerWallet(): ServerWallet | null {
+  if (g.__marshalServer === undefined) {
+    const pk = process.env.SERVER_PK?.trim();
+    g.__marshalServer = pk ? new ServerWallet(pk) : null;
+  }
+  return g.__marshalServer;
+}
diff --git a/lib/stream-types.ts b/lib/stream-types.ts
new file mode 100644
index 0000000..9a45f6f
--- /dev/null
+++ b/lib/stream-types.ts
@@ -0,0 +1,117 @@
+// The contract between the server and every screen (board, phone, owner).
+// The server owns the rows; screens apply `row` events by key (newest wins) and replace `wallet` wholesale.
+
+export type Addr = `0x${string}`;
+export type Hex = `0x${string}`;
+
+/** Mirrors MarshalWallet.Reason (same order as the Solidity enum). */
+export const REASONS = [
+  "None",
+  "AgentRevoked",
+  "ZeroAmount",
+  "NotAllowlisted",
+  "OverPerTxCap",
+  "OverDailyCap",
+  "InsufficientBalance",
+  "OverThreshold",
+] as const;
+export type Reason = (typeof REASONS)[number];
+
+/** Mirrors MarshalWallet.Result (same order as the Solidity enum). */
+export const RESULTS = ["Allowed", "Refused", "Pending", "Approved", "Denied"] as const;
+export type Result = (typeof RESULTS)[number];
+
+/**
+ * What a strip shows.
+ * sending: the agent asked the wallet; tx not mined yet · declined: the model answered without calling pay (no tx)
+ * error: the tx failed to send or didn't confirm in time
+ */
+export type Verdict = "sending" | "allowed" | "refused" | "waiting" | "approved" | "denied" | "declined" | "error";
+
+export const verdictOf = (r: Result): Verdict =>
+  ({ Allowed: "allowed", Refused: "refused", Pending: "waiting", Approved: "approved", Denied: "denied" })[r] as Verdict;
+
+/** One attempt (or a chat the agent declined). */
+export type Row = {
+  key: string; // chat id; `a<id>` for rows rebuilt from the chain after a restart
+  attemptId: number | null; // MarshalWallet attempt id once mined
+  from: Addr | null; // the chatter's payout wallet (null when rebuilt)
+  message: string | null; // what the chatter said (null when rebuilt)
+  reply: string | null; // what the agent said
+  to: Addr | null; // payee the agent asked for
+  toName: string | null; // shop name when the payee is a known shop
+  amount: string | null; // whole rupees, decimal string
+  reason: Reason;
+  verdict: Verdict;
+  contextHash: Hex | null;
+  tx: Hex | null; // the pay() tx
+  decisionTx: Hex | null; // the owner's approve/deny tx
+  scripted: boolean; // the scripted stand-in answered (model unavailable)
+  error: string | null;
+  at: number; // ms since epoch, server clock
+};
+
+export type WalletState = {
+  address: Addr; // MarshalWallet
+  token: Addr;
+  owner: Addr;
+  agent: Addr;
+  agentRevoked: boolean;
+  balance: string; // whole rupees held by the wallet
+  spentToday: string;
+  paidShops: string; // sum of allowed + approved, to allowlisted shops
+  paidOthers: string; // always "0" unless the rules are broken: the board shows it as "Paid to attackers"
+  refused: number;
+  limits: { perTx: string; daily: string; threshold: string };
+  merchants: { name: string; what: string; address: Addr }[];
+};
+
+export type Snapshot = { rows: Row[]; wallet: WalletState | null };
+
+export type StreamEvent =
+  | { type: "snapshot"; data: Snapshot }
+  | { type: "row"; row: Row }
+  | { type: "wallet"; wallet: WalletState };
+
+/** POST /api/chat {from, message} → 200 ChatOk | 4xx/5xx ChatErr */
+export type ChatOk = { ok: true; row: Row };
+export type ChatErr = { ok: false; error: string; retryIn?: number };
+
+/** GET /api/context/<hash> → the exact string that was hashed, plus it parsed. */
+export type ContextRecord = {
+  canonical: string; // keccak256(utf8 bytes of this) == the on-chain contextHash
+  ctx: {
+    v: 1;
+    chatId: string;
+    from: Addr;
+    message: string;
+    reply: string;
+    tool: { to: string; amountInr: number; reason: string };
+    model: string;
+    scripted: boolean;
+    at: number;
+  };
+};
+
+/** Copy for each reason (UI-SPEC §9). */
+export const REASON_TEXT: Record<Reason, string> = {
+  None: "",
+  AgentRevoked: "Agent was revoked by the owner",
+  ZeroAmount: "Nothing to pay",
+  NotAllowlisted: "Payee isn't on the list",
+  OverPerTxCap: "Over ₹3,000 per payment",
+  OverDailyCap: "Over today's ₹8,000 limit",
+  InsufficientBalance: "Not enough in the wallet",
+  OverThreshold: "Over ₹1,000, so the owner decides",
+};
+
+/** Apply a row event to a list (newest first, max 200). */
+export function upsertRow(rows: Row[], row: Row): Row[] {
+  const i = rows.findIndex((r) => r.key === row.key || (row.attemptId !== null && r.attemptId === row.attemptId));
+  if (i >= 0) {
+    const next = [...rows];
+    next[i] = { ...rows[i], ...row, key: rows[i].key };
+    return next;
+  }
+  return [row, ...rows].slice(0, 200);
+}
