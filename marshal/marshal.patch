@@ -61,3 +61,38 @@ export class FundOnce<T> {
     return { promise: p, already: false };
   }
 }
+
+/** Admits at most `max` concurrent jobs; up to `queue` more wait; beyond that, refuse. */
+export class Gate {
+  private active = 0;
+  private waiting: (() => void)[] = [];
+  constructor(private max = 2, private queue = 10) {}
+  async run<T>(job: () => Promise<T>): Promise<T | "busy"> {
+    if (this.active >= this.max) {
+      if (this.waiting.length >= this.queue) return "busy";
+      await new Promise<void>((res) => this.waiting.push(res));
+    }
+    this.active++;
+    try {
+      return await job();
+    } finally {
+      this.active--;
+      this.waiting.shift()?.();
+    }
+  }
+}
+
+/** Seconds until `key` may act again under a one-per-window rule (0 = now). */
+export class Cooldown {
+  private last = new Map<string, number>();
+  constructor(private windowMs = 15_000) {}
+  left(key: string, now = Date.now()): number {
+    const t = this.last.get(key.toLowerCase());
+    return t === undefined ? 0 : Math.max(0, Math.ceil((this.windowMs - (now - t)) / 1000));
+  }
+  take(key: string, now = Date.now()) {
+    this.last.set(key.toLowerCase(), now);
+  }
+}
+
+export const MAX_MESSAGE = 280;
