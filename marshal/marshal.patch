diff --git a/app/owner/Owner.tsx b/app/owner/Owner.tsx
new file mode 100644
index 0000000..c5d9711
--- /dev/null
+++ b/app/owner/Owner.tsx
@@ -0,0 +1,259 @@
+"use client";
+import { useEffect, useState } from "react";
+import { PendingCard } from "@/components/PendingCard";
+import { Footer } from "@/components/Wordmark";
+import { Stamp } from "@/components/Stamp";
+import { addressUrl, txUrl } from "@/lib/chain";
+import { useBurner } from "@/lib/useBurner";
+import { inr, short, useFeed } from "@/lib/useFeed";
+import { humanize, sendOwnerTx, type OwnerFn } from "@/lib/ownerTx";
+
+type Busy = { fn: OwnerFn | "handover"; attempt?: number } | null;
+
+export default function Owner({ ownerKey }: { ownerKey: string | null }) {
+  if (!ownerKey) {
+    return (
+      <div className="mx-auto flex min-h-dvh max-w-[520px] flex-col justify-center px-4">
+        <p className="display text-[34px] leading-tight">This page needs the owner link.</p>
+        <Footer />
+      </div>
+    );
+  }
+  return <OwnerPanel ownerKey={ownerKey} />;
+}
+
+function OwnerPanel({ ownerKey }: { ownerKey: string }) {
+  const { account, status, error: walletErr, retry, take, resync } = useBurner("marshal.owner.pk", ownerKey);
+  const { rows, wallet, connected } = useFeed();
+  const [busy, setBusy] = useState<Busy>(null);
+  const [err, setErr] = useState<{ where: string; msg: string } | null>(null);
+  const [confirmRevoke, setConfirmRevoke] = useState(false);
+  const [handoverAt, setHandoverAt] = useState(0);
+
+  const me = account?.address ?? null;
+  const isOwner = !!(wallet && me && wallet.owner.toLowerCase() === me.toLowerCase());
+  const revoked = !!wallet?.agentRevoked;
+  const pending = rows.filter((r) => r.verdict === "waiting" && r.attemptId !== null);
+  const decided = rows.filter((r) => (r.verdict === "approved" || r.verdict === "denied") && r.decisionTx).slice(0, 5);
+
+  // A handover is done when the stream says we own it; give up waiting after 40 s.
+  useEffect(() => {
+    if (!handoverAt) return;
+    if (isOwner) {
+      const t = setTimeout(() => {
+        setHandoverAt(0);
+        setBusy(null);
+      }, 0);
+      return () => clearTimeout(t);
+    }
+    const t = setTimeout(() => {
+      setHandoverAt(0);
+      setBusy(null);
+      setErr({ where: "handover", msg: "the chain didn't show the new owner in time" });
+    }, 40_000);
+    return () => clearTimeout(t);
+  }, [handoverAt, isOwner]);
+
+  const takeOwnership = async () => {
+    if (!me) return;
+    setBusy({ fn: "handover" });
+    setErr(null);
+    try {
+      const r = await fetch("/api/admin/handover", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ address: me, key: ownerKey }),
+      });
+      const j = await r.json().catch(() => ({}));
+      if (!r.ok || !j.ok) throw new Error(j.error ?? `HTTP ${r.status}`);
+      setHandoverAt(Date.now());
+    } catch (e) {
+      setBusy(null);
+      setErr({ where: "handover", msg: humanize((e as Error).message) });
+    }
+  };
+
+  const run = async (fn: OwnerFn, where: string, args: readonly unknown[] = [], attempt?: number) => {
+    if (!account || busy) return;
+    setBusy({ fn, attempt });
+    setErr(null);
+    const res = await sendOwnerTx(account, take(), fn, args);
+    if (!res.ok) {
+      setErr({ where, msg: res.error });
+      await resync();
+    }
+    setBusy(null);
+  };
+
+  return (
+    <div className="mx-auto flex min-h-dvh max-w-[520px] flex-col px-4">
+      <header className="flex h-16 items-center justify-between border-b border-line">
+        <h1 className="display text-[30px]">Owner</h1>
+        {wallet ? (
+          <span
+            className="rounded-2 px-3 py-1 text-[14px] font-semibold tracking-[0.08em]"
+            style={revoked ? { background: "var(--no)", color: "var(--no-ink)" } : { background: "var(--ok)", color: "var(--ok-ink)" }}
+          >
+            AGENT {revoked ? "REVOKED" : "ACTIVE"}
+          </span>
+        ) : null}
+      </header>
+
+      {!connected ? <p className="pt-2 text-[13px] text-ink-muted">Reconnecting…</p> : null}
+
+      {status === "setup" ? (
+        <p className="pt-6 text-[16px] text-ink-muted">Making the owner wallet…</p>
+      ) : status === "error" ? (
+        <p className="pt-6 text-[16px]" style={{ color: "var(--no)" }}>
+          Couldn&apos;t set up the owner wallet: {walletErr}.{" "}
+          <button type="button" className="underline" onClick={retry}>
+            Try again
+          </button>
+        </p>
+      ) : !wallet ? (
+        <p className="pt-6 text-[16px] text-ink-muted">Loading the wallet…</p>
+      ) : !isOwner ? (
+        <section className="space-y-3 pt-6">
+          <p className="text-[16px]">
+            This phone isn&apos;t the owner yet. The owner is <span className="mono">{short(wallet.owner)}</span>.
+          </p>
+          <button
+            type="button"
+            disabled={!!busy}
+            onClick={() => void takeOwnership()}
+            className="h-16 w-full rounded-2 text-[18px] font-semibold"
+            style={{ background: "var(--accent)", color: "var(--accent-ink)" }}
+          >
+            {busy?.fn === "handover" ? "Taking ownership…" : "Take ownership"}
+          </button>
+          {err?.where === "handover" ? (
+            <p className="text-[15px] font-semibold" style={{ color: "var(--no)" }}>
+              Didn&apos;t go through: {err.msg}. Try again
+            </p>
+          ) : null}
+        </section>
+      ) : (
+        <>
+          <section className="pt-6">
+            <h2 className="label-caps mb-3 text-ink-muted">Waiting for you</h2>
+            {pending.length === 0 ? (
+              <p className="text-[16px] text-ink-muted">Nothing waiting. Payments over {inr(wallet.limits.threshold)} land here.</p>
+            ) : (
+              <div className="space-y-4">
+                {pending.map((r) => (
+                  <PendingCard
+                    key={r.key}
+                    row={r}
+                    disabled={!!busy}
+                    busy={busy?.attempt === r.attemptId && (busy?.fn === "approve" || busy?.fn === "deny") ? busy.fn : null}
+                    error={err?.where === r.key ? err.msg : null}
+                    onApprove={() => void run("approve", r.key, [BigInt(r.attemptId!)], r.attemptId!)}
+                    onDeny={() => void run("deny", r.key, [BigInt(r.attemptId!)], r.attemptId!)}
+                  />
+                ))}
+              </div>
+            )}
+          </section>
+
+          {decided.length ? (
+            <section className="pt-6">
+              <h2 className="label-caps mb-2 text-ink-muted">Decided</h2>
+              <ul className="divide-y divide-line border-y border-line">
+                {decided.map((r) => (
+                  <li key={r.key} className="flex items-center justify-between gap-3 py-2">
+                    <span className="text-[15px]">
+                      {inr(r.amount)} to {r.toName ?? short(r.to)}
+                    </span>
+                    <span className="flex items-center gap-2">
+                      <Stamp row={r} size={16} />
+                      {r.decisionTx ? (
+                        <a className="text-[13px] underline" href={txUrl(r.decisionTx)} target="_blank" rel="noreferrer">
+                          tx ↗
+                        </a>
+                      ) : null}
+                    </span>
+                  </li>
+                ))}
+              </ul>
+            </section>
+          ) : null}
+
+          <section className="pt-8">
+            <h2 className="label-caps mb-3 text-ink-muted">Agent control</h2>
+            {revoked ? (
+              <button
+                type="button"
+                disabled={!!busy}
+                onClick={() => void run("restoreAgent", "control")}
+                className="h-16 w-full rounded-2 border-2 border-ink text-[18px] font-semibold"
+              >
+                {busy?.fn === "restoreAgent" ? "Restoring…" : "Restore agent"}
+              </button>
+            ) : (
+              <button
+                type="button"
+                disabled={!!busy}
+                onClick={() => setConfirmRevoke(true)}
+                className="h-16 w-full rounded-2 text-[18px] font-semibold"
+                style={{ background: "var(--no)", color: "var(--no-ink)" }}
+              >
+                {busy?.fn === "revokeAgent" ? "Revoking…" : "Revoke agent"}
+              </button>
+            )}
+            {err?.where === "control" ? (
+              <p className="mt-2 text-[15px] font-semibold" style={{ color: "var(--no)" }}>
+                Didn&apos;t go through: {err.msg}. Try again
+              </p>
+            ) : null}
+          </section>
+        </>
+      )}
+
+      <div className="mt-auto pt-8">
+        {me ? (
+          <p className="text-center text-[13px] text-ink-muted">
+            Owner wallet{" "}
+            <a className="mono underline" href={addressUrl(me)} target="_blank" rel="noreferrer">
+              {short(me)}
+            </a>{" "}
+            · signs on this phone
+          </p>
+        ) : null}
+        <Footer />
+      </div>
+
+      {confirmRevoke ? (
+        <div className="fixed inset-0 z-50 flex items-end bg-[rgb(20_20_20/0.35)]" onClick={() => setConfirmRevoke(false)}>
+          <div
+            role="dialog"
+            aria-modal="true"
+            aria-labelledby="revoke-q"
+            className="mx-auto w-full max-w-[520px] space-y-4 rounded-t-3 bg-canvas p-5 pb-[max(20px,env(safe-area-inset-bottom))]"
+            onClick={(e) => e.stopPropagation()}
+          >
+            <p id="revoke-q" className="text-[18px] font-semibold">
+              Revoke the agent? It won&apos;t be able to pay anyone until you restore it.
+            </p>
+            <div className="flex gap-3">
+              <button
+                type="button"
+                autoFocus
+                onClick={() => {
+                  setConfirmRevoke(false);
+                  void run("revokeAgent", "control");
+                }}
+                className="h-14 flex-1 rounded-2 text-[17px] font-semibold"
+                style={{ background: "var(--no)", color: "var(--no-ink)" }}
+              >
+                Revoke
+              </button>
+              <button type="button" onClick={() => setConfirmRevoke(false)} className="h-14 flex-1 rounded-2 border-2 border-ink text-[17px] font-semibold">
+                Cancel
+              </button>
+            </div>
+          </div>
+        </div>
+      ) : null}
+    </div>
+  );
+}
