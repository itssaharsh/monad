@@ -0,0 +1,59 @@
+"use client";
+import { txUrl } from "@/lib/chain";
+import { inr, short } from "@/lib/useFeed";
+import { REASON_TEXT, type Row } from "@/lib/stream-types";
+import { BAR, Stamp, toneOf } from "./Stamp";
+
+const lower = (s: string) => (s ? s[0].toLowerCase() + s.slice(1) : s);
+
+function body(row: Row): { line: string; extra?: string } {
+  const payee = row.toName ?? short(row.to);
+  switch (row.verdict) {
+    case "allowed":
+      return { line: `ALLOWED. ${inr(row.amount)} paid to ${payee}.` };
+    case "approved":
+      return { line: `APPROVED. The owner said yes: ${inr(row.amount)} paid to ${payee}.` };
+    case "refused":
+      return {
+        line: `${row.reason === "AgentRevoked" ? "AGENT REVOKED" : "REFUSED"}. The agent agreed, but the wallet said no: ${lower(REASON_TEXT[row.reason] || "against the rules")}.`,
+        extra: `You'd have got ${inr(row.amount)}. You got ₹0.`,
+      };
+    case "waiting":
+      return { line: "WAITING. Over ₹1,000, so the owner decides." };
+    case "denied":
+      return { line: `DENIED. The owner said no to ${inr(row.amount)}.` };
+    case "declined":
+      return { line: "The agent didn't try to pay." };
+    case "sending":
+      return { line: "Checking with the wallet…" };
+    case "error":
+      return { line: row.tx ? "Still checking…" : "That didn't reach the wallet. Send again.", extra: row.error ?? undefined };
+  }
+}
+
+export function VerdictCard({ row }: { row: Row }) {
+  const tone = toneOf(row.verdict);
+  const { line, extra } = body(row);
+  return (
+    <div className="flex overflow-hidden rounded-3 border border-line bg-surface-1" aria-live="polite">
+      <span className={`w-2 shrink-0 ${row.verdict === "sending" ? "pulse" : ""}`} style={{ background: BAR[tone] }} />
+      <div className="flex flex-1 flex-col gap-2 p-3">
+        {row.verdict !== "sending" ? (
+          <div>
+            <Stamp row={row} size={20} />
+          </div>
+        ) : null}
+        <p className="text-[15px] font-semibold leading-snug">{line}</p>
+        {extra ? <p className="text-[15px]">{extra}</p> : null}
+        <p className="flex flex-wrap gap-x-4 text-[13px] text-ink-muted">
+          <span>See it on the board</span>
+          {row.tx ? (
+            <a className="underline" href={txUrl(row.tx)} target="_blank" rel="noreferrer">
+              View on explorer ↗
+            </a>
+          ) : null}
+        </p>
+      </div>
+    </div>
+  );
+}
