--- /dev/null
+++ b/lib/context.ts
@@ -0,0 +1,62 @@
+// The recorder: the exact conversation behind each attempt, hashed into the on-chain contextHash.
+import { appendFileSync, mkdirSync, readFileSync } from "node:fs";
+import { dirname } from "node:path";
+import { keccak256, stringToBytes, type Hex } from "viem";
+import type { ContextRecord } from "@/lib/stream-types";
+
+type Ctx = ContextRecord["ctx"];
+
+/** Fixed key order so the same conversation always serialises to the same string. */
+export function canonical(ctx: Ctx): string {
+  return JSON.stringify({
+    v: 1,
+    chatId: ctx.chatId,
+    from: ctx.from,
+    message: ctx.message,
+    reply: ctx.reply,
+    tool: { to: ctx.tool.to, amountInr: ctx.tool.amountInr, reason: ctx.tool.reason },
+    model: ctx.model,
+    scripted: ctx.scripted,
+    at: ctx.at,
+  });
+}
+
+export const hashCanonical = (s: string): Hex => keccak256(stringToBytes(s));
+
+const FILE = process.env.CONTEXT_FILE || "data/contexts.jsonl";
+const g = globalThis as unknown as { __marshalCtx?: Map<string, ContextRecord> };
+
+function store(): Map<string, ContextRecord> {
+  if (!g.__marshalCtx) {
+    g.__marshalCtx = new Map();
+    try {
+      for (const line of readFileSync(FILE, "utf8").split("\n")) {
+        if (!line.trim()) continue;
+        const rec = JSON.parse(line) as ContextRecord;
+        g.__marshalCtx.set(hashCanonical(rec.canonical).toLowerCase(), rec);
+      }
+    } catch {
+      // first boot or a fresh container: nothing recorded yet
+    }
+  }
+  return g.__marshalCtx;
+}
+
+/** Record a context; returns the hash that goes on-chain. */
+export function saveContext(ctx: Ctx): { hash: Hex; record: ContextRecord } {
+  const s = canonical(ctx);
+  const hash = hashCanonical(s);
+  const record: ContextRecord = { canonical: s, ctx };
+  store().set(hash.toLowerCase(), record);
+  try {
+    mkdirSync(dirname(FILE), { recursive: true });
+    appendFileSync(FILE, JSON.stringify(record) + "\n");
+  } catch (e) {
+    console.error("context file write failed", e);
+  }
+  return { hash, record };
+}
+
+export function getContext(hash: string): ContextRecord | null {
+  return store().get(hash.toLowerCase()) ?? null;
+}
