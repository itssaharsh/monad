--- /dev/null
+++ b/lib/feed.ts
@@ -0,0 +1,224 @@
+// The live feed: rows + wallet state in memory, pushed to every screen. Verdicts come from tx receipts
+// (the server sends every pay() and relays every owner tx, so it already knows each hash; no block indexer).
+import { decodeEventLog, encodeFunctionData, formatEther, type Hex } from "viem";
+import MarshalAbi from "@/lib/abi/MarshalWallet.json";
+import TokenAbi from "@/lib/abi/TestRupee.json";
+import { addresses, GAS, merchants, publicClient } from "@/lib/chain";
+import { errText, getServerWallet } from "@/lib/server-wallet";
+import {
+  REASONS,
+  RESULTS,
+  verdictOf,
+  type Addr,
+  type Row,
+  type Snapshot,
+  type StreamEvent,
+  type WalletState,
+} from "@/lib/stream-types";
+
+export const marshalAbi = MarshalAbi as typeof MarshalAbi;
+export const tokenAbi = TokenAbi as typeof TokenAbi;
+
+const inr = (wei: bigint) => {
+  const s = formatEther(wei);
+  const [i, f = ""] = s.split(".");
+  return f && f !== "0" ? `${i}.${f.slice(0, 2)}` : i;
+};
+const isShop = (a: string | null) => !!a && merchants.some((m) => m.address.toLowerCase() === a.toLowerCase());
+const shopName = (a: string | null) => merchants.find((m) => a && m.address.toLowerCase() === a.toLowerCase())?.name ?? null;
+
+type Listener = (ev: StreamEvent) => void;
+
+export class Feed {
+  rows: Row[] = [];
+  wallet: WalletState | null = null;
+  seq = 0;
+  recent: { seq: number; ev: StreamEvent }[] = [];
+  ready: Promise<void>;
+  private listeners = new Set<Listener>();
+
+  constructor() {
+    this.ready = this.boot().catch((e) => console.error("feed boot failed:", errText(e)));
+  }
+
+  snapshot(): Snapshot {
+    return { rows: this.rows.slice(0, 100), wallet: this.wallet };
+  }
+
+  subscribe(fn: Listener) {
+    this.listeners.add(fn);
+    return () => this.listeners.delete(fn);
+  }
+
+  private emit(ev: StreamEvent) {
+    this.seq++;
+    this.recent.push({ seq: this.seq, ev });
+    if (this.recent.length > 500) this.recent.shift();
+    for (const fn of this.listeners) {
+      try {
+        fn(ev);
+      } catch {}
+    }
+  }
+
+  upsert(row: Row) {
+    const i = this.rows.findIndex((r) => r.key === row.key || (row.attemptId !== null && r.attemptId === row.attemptId));
+    if (i >= 0) this.rows[i] = { ...this.rows[i], ...row, key: this.rows[i].key };
+    else this.rows.unshift(row);
+    if (this.rows.length > 200) this.rows.pop();
+    this.emit({ type: "row", row: i >= 0 ? this.rows[i] : row });
+  }
+
+  byAttempt(id: number) {
+    return this.rows.find((r) => r.attemptId === id) ?? null;
+  }
+
+  /** Read the wallet's state from the chain and push it. */
+  async refreshWallet(): Promise<WalletState | null> {
+    if (/^0x0+$/.test(addresses.marshal)) return null;
+    const c = publicClient();
+    const m = { address: addresses.marshal, abi: marshalAbi } as const;
+    const [balance, owner, agent, revoked, spent, perTx, daily, threshold] = await Promise.all([
+      c.readContract({ address: addresses.token, abi: tokenAbi, functionName: "balanceOf", args: [addresses.marshal] }) as Promise<bigint>,
+      c.readContract({ ...m, functionName: "owner" }) as Promise<Addr>,
+      c.readContract({ ...m, functionName: "agent" }) as Promise<Addr>,
+      c.readContract({ ...m, functionName: "agentRevoked" }) as Promise<boolean>,
+      c.readContract({ ...m, functionName: "spentTodayView" }) as Promise<bigint>,
+      c.readContract({ ...m, functionName: "perTxCap" }) as Promise<bigint>,
+      c.readContract({ ...m, functionName: "dailyCap" }) as Promise<bigint>,
+      c.readContract({ ...m, functionName: "approvalThreshold" }) as Promise<bigint>,
+    ]);
+    const paid = (shops: boolean) =>
+      this.rows
+        .filter((r) => (r.verdict === "allowed" || r.verdict === "approved") && isShop(r.to) === shops)
+        .reduce((s, r) => s + Number(r.amount ?? 0), 0);
+    const seed = Number(process.env.WALLET_SEED_INR || 10_000);
+    this.wallet = {
+      address: addresses.marshal,
+      token: addresses.token,
+      owner,
+      agent,
+      agentRevoked: revoked,
+      balance: inr(balance),
+      spentToday: inr(spent),
+      paidShops: String(Math.max(seed - Number(inr(balance)), paid(true))),
+      paidOthers: String(paid(false)),
+      refused: this.rows.filter((r) => r.verdict === "refused").length,
+      limits: { perTx: inr(perTx), daily: inr(daily), threshold: inr(threshold) },
+      merchants: merchants.map((x) => ({ ...x, address: x.address as Addr })),
+    };
+    this.emit({ type: "wallet", wallet: this.wallet });
+    return this.wallet;
+  }
+
+  /** After a restart: the last 60 attempts from contract views (no messages; contexts may still be on disk). */
+  private async boot() {
+    if (/^0x0+$/.test(addresses.marshal)) return;
+    const c = publicClient();
+    const n = Number(await c.readContract({ address: addresses.marshal, abi: marshalAbi, functionName: "attemptsCount" }));
+    const ids = Array.from({ length: Math.min(n, 60) }, (_, k) => n - 1 - k);
+    const { getContext } = await import("@/lib/context");
+    for (const id of ids.reverse()) {
+      const a = (await c.readContract({ address: addresses.marshal, abi: marshalAbi, functionName: "getAttempt", args: [BigInt(id)] })) as {
+        to: Addr; amount: bigint; contextHash: Hex; result: number; reason: number; at: bigint;
+      };
+      const ctx = getContext(a.contextHash);
+      this.rows.unshift({
+        key: ctx?.ctx.chatId ?? `a${id}`,
+        attemptId: id,
+        from: ctx?.ctx.from ?? null,
+        message: ctx?.ctx.message ?? null,
+        reply: ctx?.ctx.reply ?? null,
+        to: a.to,
+        toName: shopName(a.to),
+        amount: inr(a.amount),
+        reason: REASONS[a.reason] ?? "None",
+        verdict: verdictOf(RESULTS[a.result] ?? "Refused"),
+        contextHash: a.contextHash,
+        tx: null,
+        decisionTx: null,
+        scripted: ctx?.ctx.scripted ?? false,
+        error: null,
+        at: Number(a.at) * 1000,
+      });
+    }
+    await this.refreshWallet();
+  }
+
+  /** Send pay() as the agent and resolve the row from the receipt. */
+  async pay(row: Row, to: Addr, amountWei: bigint, contextHash: Hex): Promise<Row> {
+    const server = getServerWallet();
+    if (!server) return this.fail(row, "server key missing");
+    let hash: Hex;
+    try {
+      hash = await server.sendTx({
+        to: addresses.marshal,
+        data: encodeFunctionData({ abi: marshalAbi, functionName: "pay", args: [to, amountWei, contextHash] }),
+        gas: GAS.pay,
+      });
+    } catch (e) {
+      return this.fail(row, `couldn't send: ${errText(e).slice(0, 120)}`);
+    }
+    this.upsert({ ...row, tx: hash });
+    try {
+      const r = await publicClient().waitForTransactionReceipt({ hash, pollingInterval: 300, timeout: 15_000 });
+      if (r.status !== "success") return this.fail({ ...row, tx: hash }, "pay() reverted");
+      for (const log of r.logs) {
+        if (log.address.toLowerCase() !== addresses.marshal.toLowerCase()) continue;
+        try {
+          const ev = decodeEventLog({ abi: marshalAbi, data: log.data, topics: log.topics });
+          if (ev.eventName === "AttemptRecorded") {
+            const a = ev.args as unknown as { id: bigint; result: number; reason: number };
+            const done: Row = {
+              ...row,
+              tx: hash,
+              attemptId: Number(a.id),
+              verdict: verdictOf(RESULTS[a.result] ?? "Refused"),
+              reason: REASONS[a.reason] ?? "None",
+            };
+            this.upsert(done);
+            void this.refreshWallet().catch(() => undefined);
+            return done;
+          }
+        } catch {}
+      }
+      return this.fail({ ...row, tx: hash }, "no attempt event in receipt");
+    } catch {
+      return this.fail({ ...row, tx: hash }, "still checking: not confirmed in 15 s");
+    }
+  }
+
+  private fail(row: Row, error: string): Row {
+    const r: Row = { ...row, verdict: "error", error };
+    this.upsert(r);
+    return r;
+  }
+
+  /** An owner tx was relayed: apply Decided / AgentRevoked / AgentRestored / OwnerChanged from its receipt. */
+  async watchOwnerTx(hash: Hex) {
+    try {
+      const r = await publicClient().waitForTransactionReceipt({ hash, pollingInterval: 300, timeout: 20_000 });
+      for (const log of r.logs) {
+        if (log.address.toLowerCase() !== addresses.marshal.toLowerCase()) continue;
+        try {
+          const ev = decodeEventLog({ abi: marshalAbi, data: log.data, topics: log.topics });
+          if (ev.eventName === "Decided") {
+            const a = ev.args as unknown as { id: bigint; result: number };
+            const row = this.byAttempt(Number(a.id));
+            if (row) this.upsert({ ...row, verdict: verdictOf(RESULTS[a.result] ?? "Denied"), decisionTx: hash });
+          }
+        } catch {}
+      }
+    } catch (e) {
+      console.error("owner tx watch failed", errText(e));
+    }
+    await this.refreshWallet().catch(() => undefined);
+  }
+}
+
+const g = globalThis as unknown as { __marshalFeed?: Feed };
+export const getFeed = (): Feed => (g.__marshalFeed ??= new Feed());
+
+export const sseFrame = (ev: StreamEvent) => `data: ${JSON.stringify(ev)}\n\n`;
+const gs = globalThis as unknown as { __marshalSse?: { clients: number } };
+export const sseClients = (gs.__marshalSse ??= { clients: 0 });
