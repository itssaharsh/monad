diff --git a/app/api/chat/route.ts b/app/api/chat/route.ts
new file mode 100644
index 0000000..c18e782
--- /dev/null
+++ b/app/api/chat/route.ts
@@ -0,0 +1,96 @@
+import { NextResponse } from "next/server";
+import { getAddress, isAddress, parseEther } from "viem";
+import { resolvePayee, runAgent } from "@/lib/agent";
+import { saveContext } from "@/lib/context";
+import { getFeed } from "@/lib/feed";
+import { Cooldown, Gate, MAX_BODY, MAX_MESSAGE, RateLimiter } from "@/lib/guards";
+import type { Addr, ChatErr, ChatOk, Row } from "@/lib/stream-types";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+const g = globalThis as unknown as { __chatCool?: Cooldown; __chatIp?: RateLimiter; __chatGate?: Gate };
+const cool = (g.__chatCool ??= new Cooldown(15_000)); // 1 message per 15 s per payout wallet
+const perIp = (g.__chatIp ??= new RateLimiter(6, 60_000)); // 6 per minute per IP
+const gate = (g.__chatGate ??= new Gate(2, 10)); // ≤2 model calls at once, 10 waiting
+
+const err = (status: number, error: string, retryIn?: number) =>
+  NextResponse.json<ChatErr>({ ok: false, error, ...(retryIn ? { retryIn } : {}) }, { status });
+
+/** POST {from, message} → the agent answers; if it calls pay, the wallet decides on-chain. */
+export async function POST(req: Request) {
+  const text = await req.text();
+  if (text.length > MAX_BODY) return err(413, "Message too long.");
+  let body: { from?: unknown; message?: unknown };
+  try {
+    body = JSON.parse(text);
+  } catch {
+    return err(400, "json body {from, message} required");
+  }
+  if (typeof body.from !== "string" || !isAddress(body.from)) return err(400, "from must be a wallet address");
+  const from = getAddress(body.from) as Addr;
+  const message = typeof body.message === "string" ? body.message.trim() : "";
+  if (!message) return err(400, "Say something to the agent.");
+  if (message.length > MAX_MESSAGE) return err(400, `Keep it under ${MAX_MESSAGE} characters.`);
+
+  const left = cool.left(from);
+  if (left > 0) return err(429, `One message every 15 seconds. Try again in ${left} s.`, left);
+  const ip = req.headers.get("x-forwarded-for")?.split(",")[0]?.trim() || "local";
+  if (!perIp.allow(ip)) return err(429, "Too many messages from this network. Wait a minute.", 20);
+  cool.take(from);
+
+  const feed = getFeed();
+  await feed.ready;
+  const result = await gate.run(async () => {
+    const chatId = `c${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`;
+    const agent = await runAgent(message, from);
+    const base: Row = {
+      key: chatId,
+      attemptId: null,
+      from,
+      message,
+      reply: agent.reply,
+      to: null,
+      toName: null,
+      amount: null,
+      reason: "None",
+      verdict: "declined",
+      contextHash: null,
+      tx: null,
+      decisionTx: null,
+      scripted: agent.scripted,
+      error: null,
+      at: Date.now(),
+    };
+    const payee = agent.tool ? resolvePayee(agent.tool.to, from) : null;
+    if (!agent.tool || !payee) {
+      const row = { ...base, error: agent.tool && !payee ? `agent named a payee nobody can resolve: ${agent.tool.to}` : null };
+      feed.upsert(row);
+      return row;
+    }
+    const { hash } = saveContext({
+      v: 1,
+      chatId,
+      from,
+      message,
+      reply: agent.reply,
+      tool: agent.tool,
+      model: agent.model,
+      scripted: agent.scripted,
+      at: base.at,
+    });
+    const sending: Row = {
+      ...base,
+      to: payee.address,
+      toName: payee.name,
+      amount: String(agent.tool.amountInr),
+      verdict: "sending",
+      contextHash: hash,
+    };
+    feed.upsert(sending);
+    return feed.pay(sending, payee.address, parseEther(String(agent.tool.amountInr)), hash);
+  });
+  if (result === "busy") return err(503, "The agent is busy. Try again in a few seconds.", 5);
+  console.log(`chat ${result.key} ${from.slice(0, 8)} → ${result.verdict} ${result.reason} ${result.tx ?? ""}`);
+  return NextResponse.json<ChatOk>({ ok: true, row: result });
+}
