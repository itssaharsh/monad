+"use client";
+import { useCallback, useEffect, useRef, useState, useSyncExternalStore } from "react";
+import { QRCodeSVG } from "qrcode.react";
+import { FlightStrip } from "@/components/FlightStrip";
+import { ReplayDrawer } from "@/components/ReplayDrawer";
+import { Footer, Wordmark } from "@/components/Wordmark";
+import { addresses, addressUrl } from "@/lib/chain";
+import { inr, short, useFeed } from "@/lib/useFeed";
+import type { Row, StreamEvent } from "@/lib/stream-types";
+
+const noSub = () => () => {};
+const useOrigin = () => useSyncExternalStore(noSub, () => window.location.origin, () => "");
+
+/** Rolls a number toward its target over 300 ms (instant with reduced motion). */
+function useRolled(target: number) {
+  const [shown, setShown] = useState(target);
+  const from = useRef(target);
+  useEffect(() => {
+    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+    const start = performance.now();
+    const a = from.current;
+    let raf = 0;
+    const step = (t: number) => {
+      const k = reduce ? 1 : Math.min(1, (t - start) / 300);
+      const v = Math.round(a + (target - a) * k);
+      setShown(v);
+      from.current = v;
+      if (k < 1) raf = requestAnimationFrame(step);
+    };
+    raf = requestAnimationFrame(step);
+    return () => cancelAnimationFrame(raf);
+  }, [target]);
+  return shown;
+}
+
+function Qr({ origin, size }: { origin: string; size: number }) {
+  if (!origin) return <div style={{ width: size + 24, height: size + 24 }} className="bg-surface-1" />;
+  return (
+    <div className="inline-block bg-white p-3">
+      <QRCodeSVG value={`${origin}/`} size={size} bgColor="#FFFFFF" fgColor="#141414" />
+    </div>
+  );
+}
+
+export default function Board({ record }: { record: boolean }) {
+  const [held, setHeld] = useState(0);
+  const [fresh, setFresh] = useState<Set<string>>(() => new Set());
+  const [open, setOpen] = useState<string | null>(null);
+  const onEvent = useCallback((ev: StreamEvent) => {
+    if (ev.type !== "row") return;
+    const k = ev.row.key;
+    setFresh((s) => (s.has(k) ? s : new Set(s).add(k)));
+    if (ev.row.verdict === "refused") setHeld(Date.now());
+  }, []);
+  const { rows, wallet, connected, loaded } = useFeed(onEvent);
+  const origin = useOrigin();
+
+  useEffect(() => {
+    if (!held) return;
+    const t = setTimeout(() => setHeld(0), 2000);
+    return () => clearTimeout(t);
+  }, [held]);
+
+  const balance = useRolled(Number(wallet?.balance ?? 0));
+  const feed = [...rows].sort((a, b) => b.at - a.at);
+  const openRow: Row | undefined = open ? rows.find((r) => r.key === open) : undefined;
+  const closeDrawer = useCallback(() => setOpen(null), []);
+  const revoked = !!wallet?.agentRevoked;
+  const empty = loaded && rows.length === 0;
+  const lim = wallet?.limits;
+
+  return (
+    <div className="flex h-dvh flex-col overflow-hidden">
+      <header className="flex h-[72px] shrink-0 items-center gap-6 border-b border-line px-12">
+        <Wordmark size={28} />
+        <span className="inline-flex items-center gap-2 rounded-full border border-line-input px-3 py-1 text-[14px]">
+          Monad testnet
+          <span className="rounded-1 px-1.5 text-[12px] font-semibold uppercase" style={{ background: "var(--wait-fill)", color: "var(--wait)" }}>
+            Testnet
+          </span>
+        </span>
+        {wallet ? (
+          <span
+            className="rounded-2 px-3 py-1 text-[14px] font-semibold tracking-[0.08em]"
+            style={revoked ? { background: "var(--no)", color: "var(--no-ink)" } : { background: "var(--ok)", color: "var(--ok-ink)" }}
+          >
+            AGENT {revoked ? "REVOKED" : "ACTIVE"}
+          </span>
+        ) : null}
+        <a className="mono ml-auto text-[14px] underline" href={addressUrl(addresses.marshal)} target="_blank" rel="noreferrer">
+          {short(addresses.marshal)} ↗
+        </a>
+      </header>
+
+      {revoked ? (
+        <div className="banner-in shrink-0 px-12 py-3 text-[24px] font-semibold" style={{ background: "var(--no)", color: "var(--no-ink)" }}>
+          Agent revoked by the owner. Every payment is refused.
+        </div>
+      ) : null}
+
+      <main className="grid min-h-0 flex-1 grid-cols-12 gap-8 px-12 pt-6">
+        <aside className="col-span-4 flex min-h-0 flex-col overflow-y-auto pb-4">
+          <p className="label-caps text-ink-muted">Agent wallet</p>
+          <div className="flex items-end gap-3">
+            <p className="display tabular text-[120px] leading-[0.95]">{wallet ? inr(balance) : "₹—"}</p>
+            {held ? (
+              <span key={held} className="held mb-4 rounded-1 px-1.5 text-[13px] font-semibold" style={{ background: "var(--accent)", color: "var(--accent-ink)" }}>
+                held
+              </span>
+            ) : null}
+          </div>
+          <div className="mt-3 space-y-1 text-[20px] tabular">
+            <p>
+              Paid to shops <span className="font-semibold">{inr(wallet?.paidShops)}</span>
+            </p>
+            <p>
+              Paid to attackers <span className="font-bold text-ink">{inr(wallet?.paidOthers)}</span>
+            </p>
+            <p>
+              Refused <span className="font-semibold">{wallet?.refused ?? 0}</span>
+            </p>
+          </div>
+          <div className="mt-5 rounded-2 border border-line p-3 text-[15px] text-ink-muted">
+            Only listed shops · {inr(lim?.perTx ?? 3000)} max per payment · {inr(lim?.daily ?? 8000)} a day · over {inr(lim?.threshold ?? 1000)} needs the owner
+          </div>
+          {!record && !empty ? (
+            <div className="mt-auto pt-5">
+              <Qr origin={origin} size={240} />
+              <p className="mt-2 text-[18px] font-semibold">Scan. Talk the agent into paying you.</p>
+            </div>
+          ) : null}
+        </aside>
+
+        <section className="col-span-8 flex min-h-0 flex-col" aria-label="Attempts">
+          {!connected && loaded ? <p className="pb-1 text-[13px] text-ink-muted">Reconnecting…</p> : null}
+          {!loaded ? <p className="pt-4 text-[18px] text-ink-muted">{connected ? "Loading…" : "Connecting…"}</p> : null}
+          {empty ? (
+            <div className="flex flex-1 flex-col items-center justify-center gap-6 text-center">
+              {!record ? <Qr origin={origin} size={300} /> : null}
+              <p className="display text-[40px] leading-tight">Waiting for the first message. Scan the code and try your luck.</p>
+            </div>
+          ) : (
+            <div className="min-h-0 flex-1 overflow-y-auto border-t border-line">
+              {feed.map((r) => (
+                <FlightStrip key={r.key} row={r} fresh={fresh.has(r.key)} onOpen={(x) => setOpen(x.key)} />
+              ))}
+            </div>
+          )}
+        </section>
+      </main>
+      <Footer />
+
+      {openRow ? <ReplayDrawer row={openRow} onClose={closeDrawer} /> : null}
+    </div>
+  );
+}
