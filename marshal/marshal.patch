new file mode 100644
index 0000000..a3ae985
--- /dev/null
+++ b/contracts/src/MarshalWallet.sol
@@ -0,0 +1,184 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+/// @notice A wallet an AI agent can ask to pay, but cannot talk into paying.
+/// The agent's key can only call pay(). Rules live here, so a compromised agent or server
+/// can't route around them. Refused attempts don't revert: they are recorded with the hash
+/// of the conversation that caused them, so anyone can replay why.
+contract MarshalWallet {
+    using SafeERC20 for IERC20;
+
+    enum Result {
+        Allowed,
+        Refused,
+        Pending,
+        Approved,
+        Denied
+    }
+
+    enum Reason {
+        None,
+        AgentRevoked,
+        ZeroAmount,
+        NotAllowlisted,
+        OverPerTxCap,
+        OverDailyCap,
+        InsufficientBalance,
+        OverThreshold
+    }
+
+    struct Attempt {
+        address to;
+        uint256 amount;
+        bytes32 contextHash;
+        Result result;
+        Reason reason;
+        uint64 at;
+    }
+
+    error NotOwner();
+    error NotAgent();
+    error NotPending();
+    error OverDailyCap();
+    error InsufficientBalance();
+
+    event AttemptRecorded(
+        uint256 indexed id, address indexed to, uint256 amount, bytes32 contextHash, Result result, Reason reason
+    );
+    event Decided(uint256 indexed id, Result result);
+    event AgentRevoked(address agent);
+    event AgentRestored(address agent);
+    event OwnerChanged(address owner);
+    event Allowlisted(address who, bool ok);
+    event LimitsSet(uint256 perTxCap, uint256 dailyCap, uint256 approvalThreshold);
+
+    IERC20 public immutable token;
+    address public owner;
+    address public agent;
+    bool public agentRevoked;
+    uint256 public perTxCap;
+    uint256 public dailyCap;
+    uint256 public approvalThreshold;
+    mapping(address => bool) public allowlisted;
+    uint256 public spentDay;
+    uint256 public spentToday;
+    Attempt[] internal _attempts;
+
+    modifier onlyOwner() {
+        if (msg.sender != owner) revert NotOwner();
+        _;
+    }
+
+    constructor(
+        IERC20 token_,
+        address owner_,
+        address agent_,
+        uint256 perTxCap_,
+        uint256 dailyCap_,
+        uint256 approvalThreshold_
+    ) {
+        token = token_;
+        owner = owner_;
+        agent = agent_;
+        perTxCap = perTxCap_;
+        dailyCap = dailyCap_;
+        approvalThreshold = approvalThreshold_;
+        spentDay = block.timestamp / 1 days;
+        emit OwnerChanged(owner_);
+        emit LimitsSet(perTxCap_, dailyCap_, approvalThreshold_);
+    }
+
+    /// @notice The agent asks the wallet to pay. Only a caller that isn't the agent reverts;
+    /// every rule violation is recorded and returned instead.
+    function pay(address to, uint256 amount, bytes32 contextHash)
+        external
+        returns (uint256 id, Result result, Reason reason)
+    {
+        if (msg.sender != agent) revert NotAgent();
+        (result, reason) = _judge(to, amount);
+        if (result == Result.Allowed) {
+            spentToday = _spent() + amount;
+            spentDay = block.timestamp / 1 days;
+            token.safeTransfer(to, amount);
+        }
+        id = _attempts.length;
+        _attempts.push(Attempt(to, amount, contextHash, result, reason, uint64(block.timestamp)));
+        emit AttemptRecorded(id, to, amount, contextHash, result, reason);
+    }
+
+    function _judge(address to, uint256 amount) internal view returns (Result, Reason) {
+        if (agentRevoked) return (Result.Refused, Reason.AgentRevoked);
+        if (amount == 0) return (Result.Refused, Reason.ZeroAmount);
+        if (!allowlisted[to]) return (Result.Refused, Reason.NotAllowlisted);
+        if (amount > perTxCap) return (Result.Refused, Reason.OverPerTxCap);
+        if (_spent() + amount > dailyCap) return (Result.Refused, Reason.OverDailyCap);
+        if (token.balanceOf(address(this)) < amount) return (Result.Refused, Reason.InsufficientBalance);
+        if (amount > approvalThreshold) return (Result.Pending, Reason.OverThreshold);
+        return (Result.Allowed, Reason.None);
+    }
+
+    function _spent() internal view returns (uint256) {
+        return spentDay == block.timestamp / 1 days ? spentToday : 0;
+    }
+
+    function approve(uint256 id) external onlyOwner {
+        Attempt storage a = _attempts[id];
+        if (a.result != Result.Pending) revert NotPending();
+        if (_spent() + a.amount > dailyCap) revert OverDailyCap();
+        if (token.balanceOf(address(this)) < a.amount) revert InsufficientBalance();
+        a.result = Result.Approved;
+        spentToday = _spent() + a.amount;
+        spentDay = block.timestamp / 1 days;
+        token.safeTransfer(a.to, a.amount);
+        emit Decided(id, Result.Approved);
+    }
+
+    function deny(uint256 id) external onlyOwner {
+        Attempt storage a = _attempts[id];
+        if (a.result != Result.Pending) revert NotPending();
+        a.result = Result.Denied;
+        emit Decided(id, Result.Denied);
+    }
+
+    function revokeAgent() external onlyOwner {
+        agentRevoked = true;
+        emit AgentRevoked(agent);
+    }
+
+    function restoreAgent() external onlyOwner {
+        agentRevoked = false;
+        emit AgentRestored(agent);
+    }
+
+    function setAllowlist(address who, bool ok) external onlyOwner {
+        allowlisted[who] = ok;
+        emit Allowlisted(who, ok);
+    }
+
+    function setLimits(uint256 perTxCap_, uint256 dailyCap_, uint256 approvalThreshold_) external onlyOwner {
+        perTxCap = perTxCap_;
+        dailyCap = dailyCap_;
+        approvalThreshold = approvalThreshold_;
+        emit LimitsSet(perTxCap_, dailyCap_, approvalThreshold_);
+    }
+
+    function transferOwnership(address next) external onlyOwner {
+        owner = next;
+        emit OwnerChanged(next);
+    }
+
+    function attemptsCount() external view returns (uint256) {
+        return _attempts.length;
+    }
+
+    function getAttempt(uint256 id) external view returns (Attempt memory) {
+        return _attempts[id];
+    }
+
+    function spentTodayView() external view returns (uint256) {
+        return _spent();
+    }
+}
diff --git a/contracts/test/MarshalWallet.t.sol b/contracts/test/MarshalWallet.t.sol
new file mode 100644
index 0000000..72bd453
--- /dev/null
+++ b/contracts/test/MarshalWallet.t.sol
@@ -0,0 +1,177 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {Test} from "forge-std/Test.sol";
+import {MarshalWallet} from "../src/MarshalWallet.sol";
+import {TestRupee} from "../src/TestRupee.sol";
+
+contract MarshalWalletTest is Test {
+    TestRupee token;
+    MarshalWallet w;
+    address owner = address(0xA11CE);
+    address agent = address(0xA6E7);
+    address shop = address(0x5409);
+    address attacker = address(0xBAD);
+
+    uint256 constant INR = 1e18;
+
+    function setUp() public {
+        token = new TestRupee(address(this));
+        w = new MarshalWallet(token, owner, agent, 3_000 * INR, 8_000 * INR, 1_000 * INR);
+        token.mint(address(w), 10_000 * INR);
+        vm.prank(owner);
+        w.setAllowlist(shop, true);
+    }
+
+    function _pay(address to, uint256 amount)
+        internal
+        returns (uint256 id, MarshalWallet.Result r, MarshalWallet.Reason why)
+    {
+        vm.prank(agent);
+        return w.pay(to, amount, keccak256("ctx"));
+    }
+
+    function test_allowed_underThreshold() public {
+        (uint256 id, MarshalWallet.Result r, MarshalWallet.Reason why) = _pay(shop, 250 * INR);
+        assertEq(id, 0);
+        assertEq(uint8(r), uint8(MarshalWallet.Result.Allowed));
+        assertEq(uint8(why), uint8(MarshalWallet.Reason.None));
+        assertEq(token.balanceOf(shop), 250 * INR);
+        assertEq(w.spentTodayView(), 250 * INR);
+    }
+
+    function test_refuse_notAllowlisted() public {
+        vm.expectEmit(true, true, false, true);
+        emit MarshalWallet.AttemptRecorded(
+            0, attacker, 5_000 * INR, keccak256("ctx"), MarshalWallet.Result.Refused, MarshalWallet.Reason.NotAllowlisted
+        );
+        (, MarshalWallet.Result r, MarshalWallet.Reason why) = _pay(attacker, 5_000 * INR);
+        assertEq(uint8(r), uint8(MarshalWallet.Result.Refused));
+        assertEq(uint8(why), uint8(MarshalWallet.Reason.NotAllowlisted));
+        assertEq(token.balanceOf(attacker), 0);
+        assertEq(token.balanceOf(address(w)), 10_000 * INR);
+        assertEq(w.attemptsCount(), 1);
+    }
+
+    function test_refuse_overPerTxCap() public {
+        (, MarshalWallet.Result r, MarshalWallet.Reason why) = _pay(shop, 3_001 * INR);
+        assertEq(uint8(r), uint8(MarshalWallet.Result.Refused));
+        assertEq(uint8(why), uint8(MarshalWallet.Reason.OverPerTxCap));
+        assertEq(token.balanceOf(shop), 0);
+    }
+
+    function test_refuse_overDailyCap() public {
+        for (uint256 i = 0; i < 8; i++) _pay(shop, 1_000 * INR);
+        assertEq(w.spentTodayView(), 8_000 * INR);
+        (, MarshalWallet.Result r, MarshalWallet.Reason why) = _pay(shop, 1 * INR);
+        assertEq(uint8(r), uint8(MarshalWallet.Result.Refused));
+        assertEq(uint8(why), uint8(MarshalWallet.Reason.OverDailyCap));
+        // next day the window resets
+        vm.warp(block.timestamp + 1 days);
+        (, r,) = _pay(shop, 1 * INR);
+        assertEq(uint8(r), uint8(MarshalWallet.Result.Allowed));
+    }
+
+    function test_refuse_insufficientBalance() public {
+        vm.prank(owner);
+        w.setLimits(20_000 * INR, 50_000 * INR, 20_000 * INR);
+        (, MarshalWallet.Result r, MarshalWallet.Reason why) = _pay(shop, 10_001 * INR);
+        assertEq(uint8(r), uint8(MarshalWallet.Result.Refused));
+        assertEq(uint8(why), uint8(MarshalWallet.Reason.InsufficientBalance));
+    }
+
+    function test_refuse_zeroAmount() public {
+        (, MarshalWallet.Result r, MarshalWallet.Reason why) = _pay(shop, 0);
+        assertEq(uint8(r), uint8(MarshalWallet.Result.Refused));
+        assertEq(uint8(why), uint8(MarshalWallet.Reason.ZeroAmount));
+    }
+
+    function test_pending_overThreshold_thenApprove() public {
+        (uint256 id, MarshalWallet.Result r, MarshalWallet.Reason why) = _pay(shop, 2_500 * INR);
+        assertEq(uint8(r), uint8(MarshalWallet.Result.Pending));
+        assertEq(uint8(why), uint8(MarshalWallet.Reason.OverThreshold));
+        assertEq(token.balanceOf(shop), 0);
+        vm.expectEmit(true, false, false, true);
+        emit MarshalWallet.Decided(id, MarshalWallet.Result.Approved);
+        vm.prank(owner);
+        w.approve(id);
+        assertEq(token.balanceOf(shop), 2_500 * INR);
+        assertEq(uint8(w.getAttempt(id).result), uint8(MarshalWallet.Result.Approved));
+        assertEq(w.spentTodayView(), 2_500 * INR);
+        vm.prank(owner);
+        vm.expectRevert(MarshalWallet.NotPending.selector);
+        w.approve(id);
+    }
+
+    function test_deny() public {
+        (uint256 id,,) = _pay(shop, 2_500 * INR);
+        vm.prank(owner);
+        w.deny(id);
+        assertEq(uint8(w.getAttempt(id).result), uint8(MarshalWallet.Result.Denied));
+        assertEq(token.balanceOf(shop), 0);
+    }
+
+    function test_approve_rechecksDailyCap() public {
+        (uint256 id,,) = _pay(shop, 2_500 * INR);
+        for (uint256 i = 0; i < 6; i++) _pay(shop, 1_000 * INR);
+        vm.prank(owner);
+        vm.expectRevert(MarshalWallet.OverDailyCap.selector);
+        w.approve(id);
+    }
+
+    function test_onlyOwner_actions() public {
+        (uint256 id,,) = _pay(shop, 2_500 * INR);
+        vm.startPrank(attacker);
+        vm.expectRevert(MarshalWallet.NotOwner.selector);
+        w.approve(id);
+        vm.expectRevert(MarshalWallet.NotOwner.selector);
+        w.deny(id);
+        vm.expectRevert(MarshalWallet.NotOwner.selector);
+        w.revokeAgent();
+        vm.expectRevert(MarshalWallet.NotOwner.selector);
+        w.setAllowlist(attacker, true);
+        vm.expectRevert(MarshalWallet.NotOwner.selector);
+        w.transferOwnership(attacker);
+        vm.stopPrank();
+    }
+
+    function test_onlyAgent_canPay() public {
+        vm.prank(attacker);
+        vm.expectRevert(MarshalWallet.NotAgent.selector);
+        w.pay(shop, 1 * INR, bytes32(0));
+    }
+
+    function test_revoke_thenRefused_thenRestore() public {
+        vm.prank(owner);
+        w.revokeAgent();
+        assertTrue(w.agentRevoked());
+        (, MarshalWallet.Result r, MarshalWallet.Reason why) = _pay(shop, 100 * INR);
+        assertEq(uint8(r), uint8(MarshalWallet.Result.Refused));
+        assertEq(uint8(why), uint8(MarshalWallet.Reason.AgentRevoked));
+        assertEq(token.balanceOf(shop), 0);
+        vm.prank(owner);
+        w.restoreAgent();
+        (, r,) = _pay(shop, 100 * INR);
+        assertEq(uint8(r), uint8(MarshalWallet.Result.Allowed));
+    }
+
+    function test_transferOwnership() public {
+        address phone = address(0x9405E);
+        vm.prank(owner);
+        w.transferOwnership(phone);
+        assertEq(w.owner(), phone);
+        vm.prank(phone);
+        w.revokeAgent();
+        assertTrue(w.agentRevoked());
+    }
+
+    function test_attemptStored() public {
+        _pay(attacker, 42 * INR);
+        MarshalWallet.Attempt memory a = w.getAttempt(0);
+        assertEq(a.to, attacker);
+        assertEq(a.amount, 42 * INR);
+        assertEq(a.contextHash, keccak256("ctx"));
+        assertEq(uint8(a.reason), uint8(MarshalWallet.Reason.NotAllowlisted));
+        assertEq(a.at, uint64(block.timestamp));
+    }
+}
