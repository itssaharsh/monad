+++ b/app/api/wallet/route.ts
@@ -0,0 +1,49 @@
+import { NextResponse } from "next/server";
+import { getAddress, isAddress, parseEther, type Hex } from "viem";
+import { presenterOk } from "@/lib/presenter";
+import { publicClient } from "@/lib/chain";
+import { errText, getServerWallet, OWNER_GAS, RESERVE_FLOOR } from "@/lib/server-wallet";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+const LOW = parseEther("0.2");
+const g = globalThis as unknown as { __ownerFunding?: Map<string, Promise<Hex | null>> };
+
+/** POST {address, key} → gas for the owner phone (once, while it's low) and its next nonce. Presenter only. */
+export async function POST(req: Request) {
+  let body: { address?: unknown; key?: unknown };
+  try {
+    body = await req.json();
+  } catch {
+    return NextResponse.json({ ok: false, error: "json body required" }, { status: 400 });
+  }
+  if (!presenterOk(body.key)) return NextResponse.json({ ok: false, error: "This page needs the owner link." }, { status: 401 });
+  if (typeof body.address !== "string" || !isAddress(body.address)) return NextResponse.json({ ok: false, error: "bad address" }, { status: 400 });
+  const address = getAddress(body.address);
+  const c = publicClient();
+  const server = getServerWallet();
+  try {
+    let gas = await c.getBalance({ address });
+    if (gas < LOW && server) {
+      g.__ownerFunding ??= new Map();
+      let p = g.__ownerFunding.get(address);
+      if (!p) {
+        p = (async () => {
+          const have = await server.balance();
+          if (have < RESERVE_FLOOR + OWNER_GAS) throw new Error("server wallet is low on MON");
+          const hash = await server.sendTx({ to: address, value: OWNER_GAS, gas: 30_000n });
+          await c.waitForTransactionReceipt({ hash, pollingInterval: 300, timeout: 20_000 });
+          return hash;
+        })().finally(() => g.__ownerFunding?.delete(address));
+        g.__ownerFunding.set(address, p);
+      }
+      await p;
+      gas = await c.getBalance({ address });
+    }
+    const nonce = await c.getTransactionCount({ address, blockTag: "pending" });
+    return NextResponse.json({ ok: true, nonce, gas: gas.toString() });
+  } catch (e) {
+    return NextResponse.json({ ok: false, error: errText(e).slice(0, 160) }, { status: 502 });
+  }
+}
